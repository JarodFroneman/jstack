{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.local/evals/schemas/corpus-manifest.v1.schema.json",
  "title": "JStack Proof Plane Corpus Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusId",
    "corpusVersion",
    "status",
    "description",
    "benchmarkTiers",
    "targetFamilies",
    "taskFiles",
    "executionPlan",
    "integrity",
    "claimBoundary"
  ],
  "properties": {
    "schemaVersion": {"const": "jstack.eval.corpus-manifest.v1"},
    "corpusId": {"$ref": "#/$defs/identifier"},
    "corpusVersion": {"$ref": "#/$defs/identifier"},
    "status": {"const": "development-only"},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "benchmarkTiers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "availability", "source"],
        "properties": {
          "id": {"type": "string", "enum": ["tier0", "tier1", "tier2", "tier3", "holdout"]},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
          "availability": {"type": "string", "enum": ["available", "planned", "sealed"]},
          "source": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "targetFamilies": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "languages", "plannedTaskKinds", "plannedTaskCount", "independentVerification"],
        "properties": {
          "id": {"$ref": "#/$defs/family"},
          "languages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 100}
          },
          "plannedTaskKinds": {
            "type": "array",
            "prefixItems": [
              {"const": "seeded-defect"},
              {"const": "historical-replay"},
              {"const": "clean-control"}
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "plannedTaskCount": {"const": 3},
          "independentVerification": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 300}
          }
        }
      }
    },
    "taskFiles": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "executionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "evidenceClass", "expectedRuns"],
      "properties": {
        "planId": {"$ref": "#/$defs/identifier"},
        "evidenceClass": {
          "type": "string",
          "enum": ["none", "development-mock", "public", "holdout", "pilot"]
        },
        "expectedRuns": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runId",
              "pairId",
              "taskId",
              "taskDigest",
              "family",
              "taskKind",
              "condition",
              "mode",
              "repetition",
              "evidenceClass",
              "hostSha256",
              "environmentSha256",
              "limitsSha256",
              "baselineCommit",
              "hiddenTestBundleSha256"
            ],
            "properties": {
              "runId": {"$ref": "#/$defs/identifier"},
              "pairId": {"$ref": "#/$defs/identifier"},
              "taskId": {"$ref": "#/$defs/identifier"},
              "taskDigest": {"$ref": "#/$defs/sha256"},
              "family": {"$ref": "#/$defs/family"},
              "taskKind": {"type": "string", "enum": ["seeded-defect", "historical-replay", "clean-control"]},
              "condition": {"type": "string", "enum": ["plain", "jstack"]},
              "mode": {"type": "string", "enum": ["controlled", "operational"]},
              "repetition": {"type": "integer", "minimum": 1, "maximum": 10000},
              "evidenceClass": {"type": "string", "enum": ["development-mock", "public", "holdout", "pilot"]},
              "hostSha256": {"$ref": "#/$defs/sha256"},
              "environmentSha256": {"$ref": "#/$defs/sha256"},
              "limitsSha256": {"$ref": "#/$defs/sha256"},
              "baselineCommit": {"$ref": "#/$defs/gitCommit"},
              "hiddenTestBundleSha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digestAlgorithm", "lockPath"],
      "properties": {
        "digestAlgorithm": {"const": "sha256-raw-bytes-v1"},
        "lockPath": {"$ref": "#/$defs/relativePath"}
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realProjectResultsAvailable",
        "hostModelComparisonAvailable",
        "jstackUpliftClaimAllowed",
        "zeroDayDetectionClaimAllowed",
        "note"
      ],
      "properties": {
        "realProjectResultsAvailable": {"const": false},
        "hostModelComparisonAvailable": {"const": false},
        "jstackUpliftClaimAllowed": {"const": false},
        "zeroDayDetectionClaimAllowed": {"const": false},
        "note": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
    },
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "family": {
      "type": "string",
      "enum": [
        "typescript-web",
        "python-api",
        "java-csharp-service",
        "c-cpp-system",
        "data-database",
        "legacy-repository"
      ]
    }
  }
}
