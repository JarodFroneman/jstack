{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JarodFroneman/jstack/schemas/adversarial-capture.v1.schema.json",
  "title": "JStack Closed Adversarial Verification Capture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "campaignId", "campaignDigest", "planDigest", "deterministicSeed", "inputCorpusDigest", "targetScopeDigest", "cases"],
  "properties": {
    "schemaVersion": {"const": "jstack.adversarial.capture.v1"},
    "campaignId": {"$ref": "#/$defs/identifier"},
    "campaignDigest": {"$ref": "#/$defs/sha256"},
    "planDigest": {"$ref": "#/$defs/sha256"},
    "deterministicSeed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "inputCorpusDigest": {"$ref": "#/$defs/sha256"},
    "targetScopeDigest": {"$ref": "#/$defs/sha256"},
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "hypothesisId", "inputDigest", "expectationDigest", "runs"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "category": {"enum": ["negative-input", "boundary-value", "invariant", "fault-injection", "authorization", "state-transition", "differential", "resource-boundary"]},
          "hypothesisId": {"$ref": "#/$defs/identifier"},
          "inputDigest": {"$ref": "#/$defs/sha256"},
          "expectationDigest": {"$ref": "#/$defs/sha256"},
          "runs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {"$ref": "#/$defs/run1"},
              {"$ref": "#/$defs/run2"}
            ],
            "items": false
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "status", "outcomeDigest", "externalEffect"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 2},
        "status": {"enum": ["confirmed", "refuted"]},
        "outcomeDigest": {"$ref": "#/$defs/sha256"},
        "externalEffect": {"const": "none-observed"}
      }
    },
    "run1": {
      "allOf": [
        {"$ref": "#/$defs/runBase"},
        {"properties": {"ordinal": {"const": 1}}}
      ]
    },
    "run2": {
      "allOf": [
        {"$ref": "#/$defs/runBase"},
        {"properties": {"ordinal": {"const": 2}}}
      ]
    }
  }
}
