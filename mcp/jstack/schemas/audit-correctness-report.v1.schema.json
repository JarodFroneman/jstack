{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JarodFroneman/jstack/schemas/audit-correctness-report.v1.schema.json",
  "title": "JStack Audit Stage 2 Correctness Report",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!\\.git(?:/|$))(?!\\.jstack-training(?:/|$))(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\).+$"
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "identifierRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "required": [
    "schemaVersion",
    "subject",
    "assessmentBoundary",
    "artifactBindings",
    "coverage",
    "evidence",
    "invariants",
    "findings",
    "regressionPlans",
    "gaps",
    "complete",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "jstack.audit.correctness-report.v1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitHead", "gitTree"],
      "properties": {
        "gitHead": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "gitTree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "assessmentBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryContentTrust",
        "verificationModes",
        "qaExecutionProfile",
        "untrustedExecution",
        "networkAuthority",
        "secrets",
        "writes",
        "remediation"
      ],
      "properties": {
        "repositoryContentTrust": {"const": "untrusted-data"},
        "verificationModes": {
          "type": "array",
          "prefixItems": [
            {"const": "static-invariant"},
            {"const": "jstack-qa"}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "qaExecutionProfile": {"const": "local-scrubbed-no-os-sandbox-v1"},
        "untrustedExecution": {"const": "external-sandbox-required"},
        "networkAuthority": {"const": "none"},
        "secrets": {"const": "not-accessed"},
        "writes": {"const": "training-artifacts-only"},
        "remediation": {"const": "not-authorized"}
      }
    },
    "artifactBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariants", "reproductions"],
      "properties": {
        "invariants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": ".jstack-training/invariants.md"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "reproductions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": ".jstack-training/reproductions"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason", "evidence"],
        "properties": {
          "id": {
            "enum": ["logic", "state-transitions", "error-handling", "reliability"]
          },
          "status": {"enum": ["assessed", "not-applicable", "unsupported"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence": {"$ref": "#/$defs/evidenceRefs"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "lineStart", "lineEnd", "sha256"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "path": {"$ref": "#/$defs/sourcePath"},
          "lineStart": {"type": "integer", "minimum": 1},
          "lineEnd": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "scope", "status", "evidence"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
          "scope": {"type": "string", "minLength": 1, "maxLength": 500},
          "status": {"enum": ["holds", "violated"]},
          "evidence": {"$ref": "#/$defs/evidenceRefs"}
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "title",
          "severity",
          "confidence",
          "disposition",
          "verificationStatus",
          "reachability",
          "rootCause",
          "trigger",
          "expectedBehavior",
          "observedBehavior",
          "impact",
          "evidence",
          "invariantIds",
          "reproductionIds"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "category": {
            "enum": ["logic", "state-transitions", "error-handling", "reliability"]
          },
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "confidence": {"enum": ["low", "medium", "high"]},
          "disposition": {"enum": ["blocker", "non-blocking", "hypothesis"]},
          "verificationStatus": {"enum": ["verified", "unverified"]},
          "reachability": {"enum": ["reachable", "conditional", "unproven"]},
          "rootCause": {"type": "string", "minLength": 1, "maxLength": 1000},
          "trigger": {"type": "string", "minLength": 1, "maxLength": 1000},
          "expectedBehavior": {"type": "string", "minLength": 1, "maxLength": 1000},
          "observedBehavior": {"type": "string", "minLength": 1, "maxLength": 1000},
          "impact": {"type": "string", "minLength": 1, "maxLength": 1000},
          "evidence": {"$ref": "#/$defs/evidenceRefs"},
          "invariantIds": {"$ref": "#/$defs/identifierRefs"},
          "reproductionIds": {"$ref": "#/$defs/identifierRefs"}
        }
      }
    },
    "regressionPlans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "testLevel",
          "permanentTest",
          "failsBeforeFix",
          "passesAfterFix",
          "unrelatedBehaviorChecks",
          "failureStateChecks",
          "evidence"
        ],
        "properties": {
          "findingId": {"$ref": "#/$defs/identifier"},
          "testLevel": {"enum": ["unit", "integration", "system", "property", "model"]},
          "permanentTest": {"type": "string", "minLength": 1, "maxLength": 1000},
          "failsBeforeFix": {"const": true},
          "passesAfterFix": {"const": true},
          "unrelatedBehaviorChecks": {"$ref": "#/$defs/textList"},
          "failureStateChecks": {"$ref": "#/$defs/textList"},
          "evidence": {"$ref": "#/$defs/evidenceRefs"}
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "description", "evidence"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "category": {
            "enum": ["logic", "state-transitions", "error-handling", "reliability"]
          },
          "description": {"type": "string", "minLength": 1, "maxLength": 1000},
          "evidence": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          }
        }
      }
    },
    "complete": {"const": true},
    "limitations": {
      "type": "array",
      "prefixItems": [
        {
          "const": "Stage 2 proves bounded correctness-evidence and protocol integrity, not semantic completeness, vulnerability absence, or production reliability."
        },
        {
          "const": "JStack QA uses scrubbed local execution without an OS sandbox or enforced network isolation; untrusted execution requires an external container or VM."
        },
        {
          "const": "Passing does not authorize remediation, Git changes, publication, merge, release, deployment, or production access."
        }
      ],
      "minItems": 3,
      "maxItems": 3
    }
  }
}
