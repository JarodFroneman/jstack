{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.local/schemas/delivery-phase-evidence.v1.schema.json",
  "title": "JStack Delivery Phase Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "pipelineDigest", "phaseId", "candidateFingerprint",
    "evidenceContractIds", "evidenceDigests", "complete", "passed",
    "sourceMutationObserved", "authorityEffect"
  ],
  "properties": {
    "schemaVersion": {"const": "jstack.delivery-phase-evidence.v1"},
    "pipelineDigest": {"$ref": "#/$defs/sha256"},
    "phaseId": {"enum": ["plan", "implement", "review", "qa", "browser-qa", "security", "evidence"]},
    "candidateFingerprint": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "evidenceContractIds": {"type": "array", "uniqueItems": true, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "evidenceDigests": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "complete": {"type": "boolean"},
    "passed": {"type": "boolean"},
    "sourceMutationObserved": {"type": "boolean"},
    "authorityEffect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
