{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.local/schemas/external-scanner-result.v1.schema.json",
  "title": "JStack Provider-Neutral External Scanner Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producer", "target", "scope", "ruleset", "complete", "truncated", "observedAt", "findings"],
  "properties": {
    "schemaVersion": {"const": "jstack.scanner.result.v1"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "independent"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "independent": {"type": "boolean"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitHead", "targetEnvironment", "deploymentFingerprint"],
      "properties": {
        "gitHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "targetEnvironment": {"type": "string", "minLength": 2, "maxLength": 64},
        "deploymentFingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "ruleset": {"type": "string", "minLength": 1, "maxLength": 500},
    "complete": {"type": "boolean"},
    "truncated": {"type": "boolean"},
    "observedAt": {"type": "string", "format": "date-time"},
    "findings": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "severity", "status"],
        "properties": {
          "ruleId": {"type": "string", "minLength": 1, "maxLength": 200},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "info"]},
          "status": {"type": "string", "enum": ["open", "resolved", "false-positive", "accepted-risk"]},
          "cwe": {"type": "string", "maxLength": 50},
          "location": {"type": "string", "maxLength": 2000}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
