{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.local/schemas/launch-evidence-artifact.v2.schema.json",
  "title": "JStack Native Launch Evidence Artifact v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "controlId",
    "requirementId",
    "producer",
    "target",
    "observedAt",
    "complete",
    "truncated",
    "assertions"
  ],
  "properties": {
    "schemaVersion": {"const": "jstack.launch.artifact.v2"},
    "controlId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
    "requirementId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "independent"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "independent": {"type": "boolean"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitHead", "targetEnvironment", "deploymentFingerprint", "scope"],
      "properties": {
        "gitHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "targetEnvironment": {"type": "string", "minLength": 2, "maxLength": 64},
        "deploymentFingerprint": {"$ref": "#/$defs/sha256"},
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "observedAt": {"type": "string", "format": "date-time"},
    "complete": {"type": "boolean"},
    "truncated": {"type": "boolean"},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "observations"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,119}$"},
          "status": {"type": "string", "enum": ["pass", "fail", "unknown", "not-applicable"]},
          "observations": {"type": "integer", "minimum": 0, "maximum": 1000000}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
