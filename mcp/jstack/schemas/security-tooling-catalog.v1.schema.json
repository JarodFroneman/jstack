{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.local/schemas/security-tooling-catalog.v1.schema.json",
  "title": "JStack Security Tooling Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "controls", "invariants"],
  "properties": {
    "schemaVersion": {"const": "jstack.security-tooling-catalog.v1"},
    "catalogVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "implementation", "status", "independence", "network", "executesProjectCode", "minimumRiskClass", "claimBoundary"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "category": {"type": "string", "minLength": 1, "maxLength": 100},
          "implementation": {"type": "string", "minLength": 1, "maxLength": 1000},
          "status": {"enum": ["active", "optional", "deferred", "unavailable"]},
          "independence": {"enum": ["jstack-self-check", "independent-provider", "external-control"]},
          "network": {"enum": ["none", "offline-requested-not-enforced", "external"]},
          "executesProjectCode": {"type": "boolean"},
          "minimumRiskClass": {"enum": ["trivial", "normal", "elevated", "high", "production"]},
          "claimBoundary": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolAvailabilityGrantsAuthority", "scannerPassProvesNoVulnerabilities", "localRunnerProvidesSandbox", "rawScannerOutputStoredByCatalog"],
      "properties": {
        "toolAvailabilityGrantsAuthority": {"const": false},
        "scannerPassProvesNoVulnerabilities": {"const": false},
        "localRunnerProvidesSandbox": {"const": false},
        "rawScannerOutputStoredByCatalog": {"const": false}
      }
    }
  }
}
