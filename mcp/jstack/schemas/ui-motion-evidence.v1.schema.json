{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.dev/schemas/ui-motion-evidence.v1.schema.json",
  "title": "JStack Product UI motion runtime evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "motionSpecSha256",
    "uiContractSha256",
    "candidate",
    "producer",
    "capturedAt",
    "complete",
    "truncated",
    "results",
    "manifestSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "jstack.ui.motion-evidence.v1"},
    "motionSpecSha256": {"$ref": "#/$defs/sha256"},
    "uiContractSha256": {"$ref": "#/$defs/sha256"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "producer": {"$ref": "#/$defs/producer"},
    "capturedAt": {"$ref": "#/$defs/timestamp"},
    "complete": {"const": true},
    "truncated": {"const": false},
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2816,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/result"}
    },
    "manifestSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"},
    "timestamp": {"type": "string", "format": "date-time", "minLength": 1, "maxLength": 100},
    "platform": {
      "enum": ["web", "webview", "ios", "android", "react-native", "flutter", "electron", "tauri", "macos", "windows", "linux"]
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "allOf": [
        {"pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,499}$"},
        {"not": {"pattern": "(^|/)\\.{1,2}(/|$)|//|/$"}}
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitHead", "treeSha256", "projectFingerprint", "buildSha256", "runtimeSha256"],
      "properties": {
        "gitHead": {"$ref": "#/$defs/gitOid"},
        "treeSha256": {"$ref": "#/$defs/sha256"},
        "projectFingerprint": {"$ref": "#/$defs/sha256"},
        "buildSha256": {"$ref": "#/$defs/sha256"},
        "runtimeSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "os", "device"],
      "properties": {
        "tool": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "os": {"type": "string", "minLength": 1, "maxLength": 200},
        "device": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "mediaType"],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "mediaType": {"const": "application/json"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interactionId", "platform", "mode", "status", "observedAt", "resultSha256", "resultArtifact"],
      "properties": {
        "interactionId": {"$ref": "#/$defs/identifier"},
        "platform": {"$ref": "#/$defs/platform"},
        "mode": {"enum": ["ordinary", "reduced"]},
        "status": {"const": "pass"},
        "observedAt": {"$ref": "#/$defs/timestamp"},
        "resultSha256": {"$ref": "#/$defs/sha256"},
        "resultArtifact": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}
