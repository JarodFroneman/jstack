{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.dev/schemas/ui-motion-result.v1.schema.json",
  "title": "JStack Product UI motion runtime result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "motionSpecSha256", "interactionId", "platform", "mode",
    "buildSha256", "runtimeSha256", "producerSha256", "observedAt",
    "runtimeStrategy", "observedProperties", "enterDurationMs", "exitDurationMs",
    "inputFeedbackMs", "refreshRateHz", "frameBudgetMs", "totalFrames",
    "droppedFrames", "longTaskCount", "maximumLongTaskMs",
    "cumulativeLayoutShift", "immediateFeedback", "rapidInputSafe",
    "interruptionSafe", "cancellationSafe", "reversibleSafe",
    "keyboardOperable", "focusVisible", "focusRestored", "semanticStateClear",
    "motionIsSoleSignal", "reducedMotionMode", "spatialDistancePx",
    "scaleDelta", "blurPx", "repeatedMotion", "antiPatternsDetected", "outcome"
  ],
  "properties": {
    "schemaVersion": {"const": "jstack.ui.motion-result.v1"},
    "motionSpecSha256": {"$ref": "#/$defs/sha256"},
    "interactionId": {"$ref": "#/$defs/identifier"},
    "platform": {"$ref": "#/$defs/platform"},
    "mode": {"enum": ["ordinary", "reduced"]},
    "buildSha256": {"$ref": "#/$defs/sha256"},
    "runtimeSha256": {"$ref": "#/$defs/sha256"},
    "producerSha256": {"$ref": "#/$defs/sha256"},
    "observedAt": {"type": "string", "format": "date-time", "minLength": 1, "maxLength": 100},
    "runtimeStrategy": {"enum": ["existing", "css", "view-transitions", "platform-native"]},
    "observedProperties": {
      "type": "array", "minItems": 0, "maxItems": 3, "uniqueItems": true,
      "items": {"enum": ["opacity", "transform", "clip-path"]}
    },
    "enterDurationMs": {"type": "number", "minimum": 0, "maximum": 1000},
    "exitDurationMs": {"type": "number", "minimum": 0, "maximum": 1000},
    "inputFeedbackMs": {"type": "number", "minimum": 0, "maximum": 1000},
    "refreshRateHz": {"type": "number", "minimum": 20, "maximum": 240},
    "frameBudgetMs": {"type": "number", "minimum": 4, "maximum": 50},
    "totalFrames": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "droppedFrames": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "longTaskCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "maximumLongTaskMs": {"type": "number", "minimum": 0, "maximum": 1000000},
    "cumulativeLayoutShift": {"type": "number", "minimum": 0, "maximum": 10},
    "immediateFeedback": {"const": true},
    "rapidInputSafe": {"const": true},
    "interruptionSafe": {"const": true},
    "cancellationSafe": {"const": true},
    "reversibleSafe": {"const": true},
    "keyboardOperable": {"const": true},
    "focusVisible": {"const": true},
    "focusRestored": {"const": true},
    "semanticStateClear": {"const": true},
    "motionIsSoleSignal": {"const": false},
    "reducedMotionMode": {"type": ["string", "null"], "enum": ["instant-state", "opacity-only", "static-progress", "direct-state", null]},
    "spatialDistancePx": {"type": "number", "minimum": 0, "maximum": 1000},
    "scaleDelta": {"type": "number", "minimum": 0, "maximum": 1},
    "blurPx": {"type": "number", "minimum": 0, "maximum": 100},
    "repeatedMotion": {"const": false},
    "antiPatternsDetected": {"type": "array", "maxItems": 0},
    "outcome": {"const": "pass"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"},
    "platform": {"enum": ["web", "webview", "ios", "android", "react-native", "flutter", "electron", "tauri", "macos", "windows", "linux"]}
  }
}
