{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.dev/schemas/ui-objective-result.v1.schema.json",
  "title": "JStack Product Interface objective result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkId",
    "kind",
    "platform",
    "surfaceId",
    "buildSha256",
    "runtimeSha256",
    "producerSha256",
    "matrixCellCount",
    "matrixCells",
    "outcome",
    "blockerCount",
    "assertionCount",
    "assertions",
    "summary"
  ],
  "properties": {
    "schemaVersion": {"const": "jstack.ui.objective-result.v1"},
    "checkId": {"type": "string", "minLength": 1, "maxLength": 100},
    "kind": {"$ref": "#/$defs/objectiveKind"},
    "platform": {"$ref": "#/$defs/platform"},
    "surfaceId": {"$ref": "#/$defs/identifier"},
    "buildSha256": {"$ref": "#/$defs/sha256"},
    "runtimeSha256": {"$ref": "#/$defs/sha256"},
    "producerSha256": {"$ref": "#/$defs/sha256"},
    "matrixCellCount": {"type": "integer", "minimum": 1, "maximum": 256},
    "matrixCells": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidenceCell"}
    },
    "outcome": {"const": "pass"},
    "blockerCount": {"const": 0},
    "assertionCount": {"type": "integer", "minimum": 1, "maximum": 16},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/assertion"}
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"},
    "platform": {
      "type": "string",
      "enum": ["web", "webview", "ios", "android", "react-native", "flutter", "electron", "tauri", "macos", "windows", "linux"]
    },
    "theme": {"type": "string", "enum": ["light", "dark"]},
    "state": {
      "type": "string",
      "enum": ["normal", "hover", "focus", "pressed", "loading", "empty", "error", "disabled", "selected", "success", "destructive"]
    },
    "objectiveKind": {
      "type": "string",
      "enum": ["critical-flow", "keyboard-focus", "accessibility", "reduced-motion", "text-fit-overflow"]
    },
    "evidenceCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "platform", "theme", "viewportId", "state"],
      "properties": {
        "surfaceId": {"$ref": "#/$defs/identifier"},
        "platform": {"$ref": "#/$defs/platform"},
        "theme": {"$ref": "#/$defs/theme"},
        "viewportId": {"$ref": "#/$defs/identifier"},
        "state": {"$ref": "#/$defs/state"}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actual", "expected", "outcome"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 100},
        "actual": {"type": "string", "minLength": 1, "maxLength": 2000},
        "expected": {"type": "string", "minLength": 1, "maxLength": 2000},
        "outcome": {"const": "pass"}
      }
    },
    "assertionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "method", "summary", "measurements"],
      "properties": {
        "schemaVersion": {"const": "jstack.ui.assertion-evidence.v1"},
        "method": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "measurements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/measurement"}
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "evidenceSha256", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 100},
        "outcome": {"const": "pass"},
        "evidenceSha256": {"$ref": "#/$defs/sha256"},
        "evidence": {"$ref": "#/$defs/assertionEvidence"}
      }
    }
  }
}
