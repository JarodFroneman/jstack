{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.dev/schemas/ui-reference-contract.v1.schema.json",
  "title": "JStack Product Interface reference contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "goal",
    "baseline",
    "sourceKinds",
    "viewports",
    "prototype",
    "providerPolicy",
    "limits",
    "contractSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "jstack.ui.reference-contract.v1"},
    "bundleId": {"$ref": "#/$defs/identifier"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 4000},
    "baseline": {"$ref": "#/$defs/baseline"},
    "sourceKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["screenshot", "url-capture", "figma-export"]}
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/viewport"}
    },
    "prototype": {"$ref": "#/$defs/prototypePolicy"},
    "providerPolicy": {"$ref": "#/$defs/providerPolicy"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumSources", "maximumArtifactBytes", "maximumTotalArtifactBytes", "maximumVariants"],
      "properties": {
        "maximumSources": {"const": 16},
        "maximumArtifactBytes": {"const": 25000000},
        "maximumTotalArtifactBytes": {"const": 150000000},
        "maximumVariants": {"const": 2}
      }
    },
    "contractSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitRoot", "commonDir", "gitHead", "projectFingerprint", "treeSha256", "policyDigest"],
      "properties": {
        "gitRoot": {"type": "string", "minLength": 1, "maxLength": 2000},
        "commonDir": {"type": "string", "minLength": 1, "maxLength": 2000},
        "gitHead": {"$ref": "#/$defs/gitOid"},
        "projectFingerprint": {"$ref": "#/$defs/sha256"},
        "treeSha256": {"$ref": "#/$defs/sha256"},
        "policyDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height", "dpr"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "width": {"type": "integer", "minimum": 240, "maximum": 7680},
        "height": {"type": "integer", "minimum": 240, "maximum": 7680},
        "dpr": {"type": "number", "minimum": 1, "maximum": 4}
      }
    },
    "prototypePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxVariants", "isolatedRenderRequired", "networkAccessAllowed"],
      "properties": {
        "mode": {"enum": ["none", "html-css", "html-tailwind"]},
        "maxVariants": {"type": "integer", "minimum": 0, "maximum": 2},
        "isolatedRenderRequired": {"const": true},
        "networkAccessAllowed": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "none"}}, "required": ["mode"]},
          "then": {"properties": {"maxVariants": {"const": 0}}},
          "else": {"properties": {"maxVariants": {"minimum": 1, "maximum": 2}}}
        }
      ]
    },
    "providerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalProviderAllowed", "explicitDisclosureRequired", "hostBrowserCaptureRequiredForUrls", "rawSecretsAllowed"],
      "properties": {
        "externalProviderAllowed": {"type": "boolean"},
        "explicitDisclosureRequired": {"const": true},
        "hostBrowserCaptureRequiredForUrls": {"const": true},
        "rawSecretsAllowed": {"const": false}
      }
    }
  }
}
