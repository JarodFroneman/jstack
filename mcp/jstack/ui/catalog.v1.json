  "evidencePolicy": {
    "manifestSchemaVersion": "jstack.ui.evidence.v1",
    "finalizationSchemaVersion": "jstack.ui.finalization.v1",
    "maximumManifestBytes": 2000000,
    "maximumArtifactBytes": 25000000,
    "maximumArtifacts": 640,
    "maximumMatrixCells": 256,
