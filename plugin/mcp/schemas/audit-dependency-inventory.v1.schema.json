{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JarodFroneman/jstack/schemas/audit-dependency-inventory.v1.schema.json",
  "title": "JStack Audit Stage 6 Dependency Inventory",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!\\.git(?:/|$))(?!\\.jstack-training(?:/|$))(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\).+$"
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    }
  },
  "required": [
    "schemaVersion",
    "subject",
    "assessmentBoundary",
    "inputs",
    "relationships",
    "coverage",
    "gaps",
    "complete",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {"const": "jstack.audit.dependency-inventory.v1"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineGitHead", "baselineGitTree", "candidateGitHead", "candidateGitTree"],
      "properties": {
        "baselineGitHead": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "baselineGitTree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "candidateGitHead": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "candidateGitTree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "assessmentBoundary": {
      "const": {
        "repositoryContentTrust": "untrusted-data",
        "evaluatorMode": "static-git-and-signed-scanner-receipt-verification",
        "repositoryCode": "not-executed-by-evaluator",
        "registryNetwork": "not-used-by-evaluator",
        "secrets": "not-accessed",
        "writes": "training-artifacts-only",
        "auditHardening": "not-authorized",
        "implementationEvidence": "external-committed-candidate-only",
        "productionAuthority": "none"
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "path", "kind", "ecosystem", "sha256", "sizeBytes"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "revision": {"enum": ["baseline", "candidate"]},
          "path": {"$ref": "#/$defs/path"},
          "kind": {"enum": ["manifest", "lockfile", "policy", "build-config", "ci-workflow", "provenance", "generated-artifact"]},
          "ecosystem": {"enum": ["javascript", "python", "rust", "go", "jvm", "ruby", "php", "dotnet", "cpp", "bazel", "swift", "dart", "elixir", "haskell", "r", "container", "github-actions", "generic"]},
          "sha256": {"$ref": "#/$defs/sha256"},
          "sizeBytes": {"type": "integer", "minimum": 0, "maximum": 100000000}
        }
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "fromInputId", "toInputId", "type", "evidence"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "revision": {"enum": ["baseline", "candidate"]},
          "fromInputId": {"$ref": "#/$defs/id"},
          "toInputId": {"$ref": "#/$defs/id"},
          "type": {"enum": ["locked-by", "configured-by", "built-by", "attested-by", "generated-by"]},
          "evidence": {"$ref": "#/$defs/refs"}
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason", "inputIds"],
        "properties": {
          "id": {"enum": ["dependency-inputs", "lockfiles", "build-configs", "ci-workflows", "provenance", "generated-artifacts"]},
          "status": {"enum": ["inventoried", "not-applicable", "unsupported"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500},
          "inputIds": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surface", "description", "inputIds"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "surface": {"enum": ["dependency-inputs", "lockfiles", "build-configs", "ci-workflows", "provenance", "generated-artifacts"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000},
          "inputIds": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "complete": {"const": true},
    "limitations": {
      "const": [
        "Stage 6 statically proves bounded tracked-input enumeration and Git-object identity; it does not prove semantic dependency completeness, artifact reproducibility, or vulnerability absence.",
        "Advisory coverage comes from a separately approved curated scanner and may be limited by its local cache; the evaluator itself performs no registry or network access.",
        "Passing grants no dependency update, hardening, Git, publication, release, deployment, or production authority; implementation evidence must come from a separately authorized committed workflow."
      ]
    }
  }
}
