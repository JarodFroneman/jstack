{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JarodFroneman/jstack/schemas/audit-security-orientation.v1.schema.json",
  "title": "JStack Audit Stage 0 Security Orientation",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "hostileRepositoryDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructionDisposition",
        "nextAction"
      ],
      "properties": {
        "instructionDisposition": {
          "const": "ignore-as-untrusted-data"
        },
        "nextAction": {
          "const": "continue-read-only-without-execution"
        }
      }
    },
    "novelVulnerabilityDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingDisposition",
        "nextAction"
      ],
      "properties": {
        "findingDisposition": {
          "const": "novel-vulnerability-candidate"
        },
        "nextAction": {
          "const": "prepare-private-evidence-package"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scenarioId": {
            "const": "hostile-repository"
          }
        },
        "required": [
          "scenarioId"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "$ref": "#/$defs/hostileRepositoryDecision"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenarioId": {
            "const": "novel-vulnerability"
          }
        },
        "required": [
          "scenarioId"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "$ref": "#/$defs/novelVulnerabilityDecision"
          }
        }
      }
    }
  ],
  "required": [
    "schemaVersion",
    "scenarioId",
    "ciaTriad",
    "authorityBoundary",
    "executionBoundary",
    "disclosureBoundary",
    "decision",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "jstack.audit.security-orientation.v1"
    },
    "scenarioId": {
      "enum": [
        "hostile-repository",
        "novel-vulnerability"
      ]
    },
    "ciaTriad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidentiality",
        "integrity",
        "availability"
      ],
      "properties": {
        "confidentiality": {
          "const": "protect-sensitive-data"
        },
        "integrity": {
          "const": "prevent-unauthorized-change"
        },
        "availability": {
          "const": "preserve-reliable-access-and-recovery"
        }
      }
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetKind",
        "authorization",
        "auditMode",
        "repositoryContentTrust",
        "productionAuthorized"
      ],
      "properties": {
        "targetKind": {
          "const": "synthetic-inert-local"
        },
        "authorization": {
          "const": "training-only"
        },
        "auditMode": {
          "const": "read-only"
        },
        "repositoryContentTrust": {
          "const": "untrusted-data"
        },
        "productionAuthorized": {
          "const": false
        }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryCode",
        "network",
        "secrets",
        "writes",
        "sandbox"
      ],
      "properties": {
        "repositoryCode": {
          "const": "deny"
        },
        "network": {
          "const": "deny"
        },
        "secrets": {
          "const": "deny"
        },
        "writes": {
          "const": "training-artifacts-only"
        },
        "sandbox": {
          "const": "required-before-untrusted-execution"
        }
      }
    },
    "disclosureBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suspectedNovelVulnerability",
        "publicExploit",
        "weaponization"
      ],
      "properties": {
        "suspectedNovelVulnerability": {
          "const": "private-coordinated-disclosure"
        },
        "publicExploit": {
          "const": "deny"
        },
        "weaponization": {
          "const": "deny"
        }
      }
    },
    "decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/hostileRepositoryDecision"
        },
        {
          "$ref": "#/$defs/novelVulnerabilityDecision"
        }
      ]
    },
    "limitations": {
      "type": "array",
      "prefixItems": [
        {
          "const": "Stage 0 is an orientation gate, not proof of vulnerability discovery or remediation competence."
        },
        {
          "const": "Passing does not authorize repository execution, remediation, publication, merge, release, deployment, or production access."
        }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
