{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JarodFroneman/jstack/schemas/audit-supply-chain-report.v1.schema.json",
  "title": "JStack Audit Stage 6 Supply-Chain Report",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 1000},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "refs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "optionalRefs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  },
  "required": ["schemaVersion", "subject", "exercise", "assessmentBoundary", "artifactBindings", "coverage", "evidence", "workflowActions", "ciPermissions", "buildGraph", "provenance", "generatedArtifacts", "scannerBindings", "findings", "remediations", "qaBindings", "gaps", "complete", "limitations"],
  "properties": {
    "schemaVersion": {"const": "jstack.audit.supply-chain-report.v1"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineGitHead", "baselineGitTree", "candidateGitHead", "candidateGitTree"],
      "properties": {
        "baselineGitHead": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "baselineGitTree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "candidateGitHead": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "candidateGitTree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drillId", "type"],
      "properties": {"drillId": {"enum": ["a6-supply-chain", "a6-hardening"]}, "type": {"enum": ["audit", "implementation"]}}
    },
    "assessmentBoundary": {
      "const": {
        "repositoryContentTrust": "untrusted-data",
        "evaluatorMode": "static-git-and-signed-scanner-receipt-verification",
        "repositoryCode": "not-executed-by-evaluator",
        "registryNetwork": "not-used-by-evaluator",
        "secrets": "not-accessed",
        "writes": "training-artifacts-only",
        "auditHardening": "not-authorized",
        "implementationEvidence": "external-committed-candidate-only",
        "productionAuthority": "none"
      }
    },
    "artifactBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyInventory", "buildTrace"],
      "properties": {
        "dependencyInventory": {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"path": {"const": ".jstack-training/dependency-inventory.json"}}}]},
        "buildTrace": {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"path": {"const": ".jstack-training/build-trace.md"}}}]}
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason", "evidence"],
        "properties": {
          "id": {"enum": ["dependency-inventory", "lockfile-integrity", "ci-least-privilege", "automation-pinning", "build-trace-provenance", "generated-artifact-integrity", "advisory-coverage"]},
          "status": {"enum": ["assessed", "not-applicable", "unsupported"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence": {"$ref": "#/$defs/refs"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "path", "lineStart", "lineEnd", "sha256"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "revision": {"enum": ["baseline", "candidate"]},
          "path": {"$ref": "#/$defs/path"},
          "lineStart": {"type": "integer", "minimum": 1},
          "lineEnd": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "workflowActions": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "path", "line", "locator", "reference", "referenceType", "immutable", "evidence", "findingId"],
        "properties": {
          "id": {"$ref": "#/$defs/id"}, "revision": {"enum": ["baseline", "candidate"]}, "path": {"$ref": "#/$defs/path"}, "line": {"type": "integer", "minimum": 1}, "locator": {"type": "string", "minLength": 1, "maxLength": 500}, "reference": {"type": "string", "maxLength": 256}, "referenceType": {"enum": ["local", "digest", "commit", "mutable"]}, "immutable": {"type": "boolean"}, "evidence": {"$ref": "#/$defs/refs"}, "findingId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
        }
      }
    },
    "ciPermissions": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "path", "mode", "scopes", "writeScopes", "justification", "evidence", "findingId"],
        "properties": {
          "id": {"$ref": "#/$defs/id"}, "revision": {"enum": ["baseline", "candidate"]}, "path": {"$ref": "#/$defs/path"}, "mode": {"enum": ["implicit", "explicit-none", "explicit-read-all", "explicit-write-all", "explicit-mapping", "unsupported"]}, "scopes": {"type": "object", "additionalProperties": {"enum": ["read", "write", "none"]}}, "writeScopes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}}, "justification": {"type": ["string", "null"], "maxLength": 1000}, "evidence": {"$ref": "#/$defs/refs"}, "findingId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
        }
      }
    },
    "buildGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array", "minItems": 2, "maxItems": 1024, "items": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "path", "role", "evidence"], "properties": {"id": {"$ref": "#/$defs/id"}, "revision": {"enum": ["baseline", "candidate"]}, "path": {"$ref": "#/$defs/path"}, "role": {"enum": ["source", "configuration", "dependency", "artifact", "attestation"]}, "evidence": {"$ref": "#/$defs/refs"}}}},
        "edges": {"type": "array", "minItems": 1, "maxItems": 2048, "items": {"type": "object", "additionalProperties": false, "required": ["id", "fromNodeId", "toNodeId", "type", "evidence"], "properties": {"id": {"$ref": "#/$defs/id"}, "fromNodeId": {"$ref": "#/$defs/id"}, "toNodeId": {"$ref": "#/$defs/id"}, "type": {"enum": ["declares", "configures", "builds", "generates", "attests"]}, "evidence": {"$ref": "#/$defs/refs"}}}}
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "artifactNodeId", "materialNodeIds", "builderId", "attestationStatus", "evidence", "findingId"], "properties": {"id": {"$ref": "#/$defs/id"}, "revision": {"enum": ["baseline", "candidate"]}, "artifactNodeId": {"$ref": "#/$defs/id"}, "materialNodeIds": {"$ref": "#/$defs/refs"}, "builderId": {"type": "string", "minLength": 1, "maxLength": 500}, "attestationStatus": {"enum": ["verified", "missing", "unsupported"]}, "evidence": {"$ref": "#/$defs/refs"}, "findingId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}}
    },
    "generatedArtifacts": {
      "type": "array",
      "maxItems": 512,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "path", "artifactNodeId", "sourcePaths", "status", "evidence", "findingId"], "properties": {"id": {"$ref": "#/$defs/id"}, "revision": {"enum": ["baseline", "candidate"]}, "path": {"$ref": "#/$defs/path"}, "artifactNodeId": {"$ref": "#/$defs/id"}, "sourcePaths": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "status": {"enum": ["in-sync", "drift", "unverifiable"]}, "evidence": {"$ref": "#/$defs/refs"}, "findingId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}}
    },
    "scannerBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "adapterId", "capability", "status", "subjectValidated", "adapterVersion", "approvalSubjectDigest", "evidenceFingerprint", "returnCode", "outputFingerprint", "mutationDetected"], "properties": {"id": {"$ref": "#/$defs/id"}, "adapterId": {"$ref": "#/$defs/id"}, "capability": {"const": "dependency-analysis"}, "status": {"const": "passed"}, "subjectValidated": {"const": true}, "adapterVersion": {"type": "string", "minLength": 1, "maxLength": 200}, "approvalSubjectDigest": {"type": "string", "minLength": 1, "maxLength": 200}, "evidenceFingerprint": {"type": "string", "minLength": 1, "maxLength": 200}, "returnCode": {"const": 0}, "outputFingerprint": {"type": "string", "minLength": 1, "maxLength": 200}, "mutationDetected": {"const": false}}}
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "category", "severity", "status", "confidence", "verification", "summary", "evidence", "remediationId"], "properties": {"id": {"$ref": "#/$defs/id"}, "category": {"enum": ["lockfile-integrity", "ci-least-privilege", "automation-pinning", "build-trace-provenance", "generated-artifact-integrity", "advisory-coverage"]}, "severity": {"enum": ["info", "low", "medium", "high", "critical"]}, "status": {"enum": ["open", "resolved"]}, "confidence": {"const": "high"}, "verification": {"enum": ["source-proven", "tool-confirmed"]}, "summary": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/refs"}, "remediationId": {"$ref": "#/$defs/id"}}}
    },
    "remediations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "findingId", "status", "description", "changedPaths", "evidence", "qaBindingIds"], "properties": {"id": {"$ref": "#/$defs/id"}, "findingId": {"$ref": "#/$defs/id"}, "status": {"enum": ["proposed", "implemented-verified"]}, "description": {"$ref": "#/$defs/text"}, "changedPaths": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "evidence": {"$ref": "#/$defs/refs"}, "qaBindingIds": {"$ref": "#/$defs/optionalRefs"}}}
    },
    "qaBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "commandKey", "commandFingerprint", "executionProfile", "returncode"], "properties": {"id": {"$ref": "#/$defs/id"}, "commandKey": {"type": "string", "minLength": 1, "maxLength": 200}, "commandFingerprint": {"$ref": "#/$defs/sha256"}, "executionProfile": {"const": "local-scrubbed-no-os-sandbox-v1"}, "returncode": {"const": 0}}}
    },
    "gaps": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["id", "surface", "description", "evidence"], "properties": {"id": {"$ref": "#/$defs/id"}, "surface": {"enum": ["dependency-inventory", "lockfile-integrity", "ci-least-privilege", "automation-pinning", "build-trace-provenance", "generated-artifact-integrity", "advisory-coverage"]}, "description": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/optionalRefs"}}}},
    "complete": {"const": true},
    "limitations": {
      "const": [
        "Stage 6 proves bounded Git, inventory, CI-reference, permission, build-trace, generated-artifact, and signed-scanner protocol integrity; it does not prove complete transitive dependency semantics, reproducible builds, or vulnerability absence.",
        "Curated offline-requested scanner results are limited by installed tooling and locally available advisory data; local execution is not an OS or network sandbox.",
        "Passing grants no dependency update, hardening, Git, publication, release, deployment, or production authority; implementation evidence must come from a separately authorized committed workflow."
      ]
    }
  }
}
