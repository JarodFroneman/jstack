{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.dev/schemas/browser-provider-contract.v1.schema.json",
  "title": "JStack Browser Provider Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerId",
    "providerKind",
    "status",
    "hostId",
    "capabilities",
    "commands",
    "executionProfile",
    "sourceWrite",
    "gitWrite",
    "release",
    "deploy",
    "production",
    "authorityEffect",
    "contractDigest"
  ],
  "properties": {
    "schemaVersion": {"const": "jstack.browser-provider-contract.v1"},
    "providerId": {"const": "project-browser-script"},
    "providerKind": {"const": "project-script"},
    "status": {"enum": ["available", "unavailable", "unsupported", "error"]},
    "hostId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "accessibility-observation",
          "console-observation",
          "interaction",
          "network-observation",
          "screenshot",
          "trace"
        ]
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/command"}
    },
    "executionProfile": {"const": "local-scrubbed-no-os-or-network-sandbox-v1"},
    "sourceWrite": {"const": false},
    "gitWrite": {"const": false},
    "release": {"const": false},
    "deploy": {"const": false},
    "production": {"const": false},
    "authorityEffect": {"const": "none"},
    "contractDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "label", "source", "args", "executesProjectCode", "commandFingerprint"],
      "properties": {
        "key": {"type": "string", "pattern": "^npm:[A-Za-z0-9][A-Za-z0-9:._-]{0,99}$"},
        "kind": {"const": "browser"},
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "source": {"const": "package.json browser-script convention"},
        "args": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"const": "npm"},
            {"const": "run"},
            {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,99}$"}
          ],
          "items": false
        },
        "executesProjectCode": {"const": true},
        "commandFingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
