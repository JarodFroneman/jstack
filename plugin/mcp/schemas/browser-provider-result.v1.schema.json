{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.dev/schemas/browser-provider-result.v1.schema.json",
  "title": "JStack Browser Provider Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider",
    "candidate",
    "scenario",
    "observedAt",
    "durationMs",
    "complete",
    "truncated",
    "outcome",
    "steps",
    "assertions",
    "artifacts",
    "observations",
    "errors",
    "evidenceSha256",
    "authority"
  ],
  "properties": {
    "schemaVersion": {"const": "jstack.browser-provider-result.v1"},
    "provider": {"$ref": "#/$defs/provider"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "scenario": {"$ref": "#/$defs/scenario"},
    "observedAt": {"type": "string", "format": "date-time"},
    "durationMs": {"type": "number", "minimum": 0, "maximum": 3600000},
    "complete": {"type": "boolean"},
    "truncated": {"type": "boolean"},
    "outcome": {"enum": ["pass", "fail", "blocked", "error"]},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/step"}
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/assertion"}
    },
    "artifacts": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "observations": {"$ref": "#/$defs/observations"},
    "errors": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/error"}
    },
    "evidenceSha256": {"$ref": "#/$defs/sha256"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "version", "host", "independent", "capabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["project-script", "host-native", "gstack-browser"]},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "host": {"$ref": "#/$defs/id"},
        "independent": {"type": "boolean"},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "accessibility-observation",
              "console-observation",
              "interaction",
              "network-observation",
              "screenshot",
              "trace"
            ]
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitHead", "projectFingerprint", "buildSha256", "runtimeSha256"],
      "properties": {
        "gitHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "projectFingerprint": {"$ref": "#/$defs/sha256"},
        "buildSha256": {"$ref": "#/$defs/sha256"},
        "runtimeSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "dpr"],
      "properties": {
        "width": {"type": "integer", "minimum": 240, "maximum": 7680},
        "height": {"type": "integer", "minimum": 240, "maximum": 7680},
        "dpr": {"type": "number", "minimum": 1, "maximum": 4}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "viewport", "mode", "scenarioDigest"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "route": {"type": "string", "minLength": 1, "maxLength": 500},
        "viewport": {"$ref": "#/$defs/viewport"},
        "mode": {"enum": ["ordinary", "reduced-motion"]},
        "scenarioDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "action", "targetSha256", "status", "durationMs"],
      "properties": {
        "index": {"type": "integer", "minimum": 1, "maximum": 128},
        "action": {"$ref": "#/$defs/id"},
        "targetSha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["pass", "fail", "blocked", "error"]},
        "durationMs": {"type": "number", "minimum": 0, "maximum": 3600000}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "expectedSha256", "observedSha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["pass", "fail", "unknown"]},
        "expectedSha256": {"$ref": "#/$defs/sha256"},
        "observedSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "size", "mediaType"],
      "properties": {
        "kind": {"enum": ["accessibility", "console", "network", "screenshot", "trace"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 50000000},
        "mediaType": {"enum": ["application/json", "application/zip", "image/png", "text/plain"]}
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorCount", "warningCount", "digest"],
      "properties": {
        "errorCount": {"type": "integer", "minimum": 0},
        "warningCount": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestCount", "failedRequestCount", "externalOriginCount", "policyStatus", "digest"],
      "properties": {
        "requestCount": {"type": "integer", "minimum": 0},
        "failedRequestCount": {"type": "integer", "minimum": 0},
        "externalOriginCount": {"type": "integer", "minimum": 0},
        "policyStatus": {"enum": ["pass", "fail", "unknown"]},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "criticalViolationCount", "seriousViolationCount", "digest"],
      "properties": {
        "checked": {"type": "boolean"},
        "criticalViolationCount": {"type": "integer", "minimum": 0},
        "seriousViolationCount": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["console", "network", "accessibility"],
      "properties": {
        "console": {"$ref": "#/$defs/console"},
        "network": {"$ref": "#/$defs/network"},
        "accessibility": {"$ref": "#/$defs/accessibility"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "messageSha256"],
      "properties": {
        "code": {"$ref": "#/$defs/id"},
        "messageSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceWrite", "gitWrite", "release", "deploy", "production", "authorityEffect"],
      "properties": {
        "sourceWrite": {"const": false},
        "gitWrite": {"const": false},
        "release": {"const": false},
        "deploy": {"const": false},
        "production": {"const": false},
        "authorityEffect": {"const": "none"}
      }
    }
  }
}
