{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.local/schemas/launch-control-catalog.v2.schema.json",
  "title": "JStack Launch Control Catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "sourceProvenance",
    "surfaces",
    "riskTiers",
    "riskModel",
    "statuses",
    "evidenceKinds",
    "artifactFormats",
    "controls"
  ],
  "properties": {
    "schemaVersion": {"const": "jstack.launch.controls.v2"},
    "catalogVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "adaptationNotice"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceUrl", "reviewedAt", "purpose"],
            "properties": {
              "sourceUrl": {"type": "string", "pattern": "^https://", "maxLength": 1000},
              "reviewedAt": {"type": "string", "format": "date"},
              "purpose": {"type": "string", "minLength": 1, "maxLength": 1000}
            }
          }
        },
        "adaptationNotice": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "riskFloor"],
        "properties": {
          "id": {"$ref": "#/$defs/surface"},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "riskFloor": {"$ref": "#/$defs/riskTier"}
        }
      }
    },
    "riskTiers": {"const": ["low", "medium", "high", "critical"]},
    "riskModel": {
      "const": {
        "highSecurityControlsAreBlockers": true,
        "criticalRequiredControlsAreBlockers": true,
        "criticalWaiversAllowed": false,
        "independentScannerMinimumTier": "high",
        "criticalHumanReviewRequired": true
      }
    },
    "statuses": {"const": ["pass", "fail", "incomplete", "not-applicable", "waived"]},
    "evidenceKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidenceKind"}
    },
    "artifactFormats": {"const": ["jstack-json", "sarif-2.1.0", "scanner-json"]},
    "controls": {
      "type": "array",
      "minItems": 47,
      "maxItems": 47,
      "items": {"$ref": "#/$defs/control"}
    }
  },
  "$defs": {
    "riskTier": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "surface": {
      "type": "string",
      "enum": [
        "core",
        "public-web",
        "browser-ui",
        "authenticated",
        "cookie-authenticated",
        "database",
        "transactional-email",
        "search-indexed",
        "performance-sensitive",
        "analytics",
        "payments",
        "commercial",
        "tracking",
        "ai-paid-endpoints",
        "regulated-data",
        "public-form",
        "cross-origin-api",
        "untrusted-input",
        "cost-bearing-endpoints",
        "personal-data",
        "licensed-assets",
        "software-supply-chain"
      ]
    },
    "evidenceKind": {
      "type": "string",
      "enum": [
        "automated-test",
        "authorization-matrix",
        "browser-test",
        "code-review",
        "configuration-snapshot",
        "cost-control-report",
        "data-map",
        "datastore-probe",
        "delivery-test",
        "human-attestation",
        "legal-document",
        "manual-test",
        "monitoring-report",
        "performance-report",
        "provider-receipt",
        "http-security-report",
        "license-report",
        "penetration-test",
        "sbom",
        "security-scan"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "evidenceKinds",
        "artifactFormats",
        "minimumCount",
        "minimumDistinctProducers",
        "minimumObservations",
        "independent",
        "machineVerifiable",
        "requiredAssertions",
        "appliesAtRiskTiers"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidenceKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceKind"}
        },
        "artifactFormats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["jstack-json", "sarif-2.1.0", "scanner-json"]}
        },
        "minimumCount": {"type": "integer", "minimum": 1, "maximum": 20},
        "minimumDistinctProducers": {"type": "integer", "minimum": 1, "maximum": 20},
        "minimumObservations": {"type": "integer", "minimum": 1, "maximum": 100000},
        "independent": {"type": "boolean"},
        "machineVerifiable": {"type": "boolean"},
        "requiredAssertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,119}$"}
        },
        "appliesAtRiskTiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/riskTier"}
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "category",
        "title",
        "objective",
        "sourcePriority",
        "gateLevel",
        "minimumRiskTier",
        "applicability",
        "evidenceKinds",
        "evidenceRequirements",
        "verificationMethods",
        "maxAgeMinutes",
        "ownerRole",
        "waivable",
        "allowNotApplicable",
        "safetyNotes"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 47},
        "category": {"type": "string", "enum": ["security", "email", "findability", "speed", "analytics", "legal", "final-test"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "objective": {"type": "string", "minLength": 1, "maxLength": 1500},
        "sourcePriority": {"type": "string", "enum": ["blocker", "first-week", "nice-to-have"]},
        "gateLevel": {"type": "string", "enum": ["blocker", "required", "advisory"]},
        "minimumRiskTier": {"$ref": "#/$defs/riskTier"},
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allOf", "anyOf"],
          "properties": {
            "allOf": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/surface"}},
            "anyOf": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/surface"}}
          }
        },
        "evidenceKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceKind"}
        },
        "evidenceRequirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/requirement"}
        },
        "verificationMethods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "maxAgeMinutes": {"type": "integer", "minimum": 1, "maximum": 1440},
        "ownerRole": {"type": "string", "enum": ["lead", "architect", "builder", "reviewer", "qa", "security", "devops", "product", "docs", "legal-owner", "business-owner"]},
        "waivable": {"type": "boolean"},
        "allowNotApplicable": {"type": "boolean"},
        "safetyNotes": {"type": "string", "minLength": 1, "maxLength": 1500}
      }
    }
  }
}
