{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.local/schemas/launch-result.v2.schema.json",
  "title": "JStack Launch Final Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "projectPath",
    "gitHead",
    "projectFingerprint",
    "baseRef",
    "baseCommit",
    "policyDigest",
    "toolVersion",
    "catalogVersion",
    "catalogDigest",
    "selectionDigest",
    "riskTier",
    "derivedRiskFloor",
    "policyRiskFloor",
    "deploymentFingerprint",
    "surfaceHintDigest",
    "surfaceReconciliationDigest",
    "targetEnvironment",
    "targetUrl",
    "surfaces",
    "profileOwner",
    "profileReferenceDigest",
    "controlResults",
    "activeWaivers",
    "complete",
    "passed",
    "expiresAt",
    "serverSession",
    "issuedAt"
  ],
  "properties": {
    "kind": {"const": "launch"},
    "schemaVersion": {"const": "jstack.launch.receipt.v2"},
    "projectPath": {"type": "string", "minLength": 1},
    "gitHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "projectFingerprint": {"$ref": "#/$defs/sha256"},
    "baseRef": {"type": "string", "minLength": 1},
    "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "policyDigest": {"$ref": "#/$defs/sha256"},
    "toolVersion": {"type": "string", "minLength": 1},
    "catalogVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "catalogDigest": {"$ref": "#/$defs/sha256"},
    "selectionDigest": {"$ref": "#/$defs/sha256"},
    "riskTier": {"$ref": "#/$defs/riskTier"},
    "derivedRiskFloor": {"$ref": "#/$defs/riskTier"},
    "policyRiskFloor": {"$ref": "#/$defs/riskTier"},
    "deploymentFingerprint": {"$ref": "#/$defs/sha256"},
    "surfaceHintDigest": {"$ref": "#/$defs/sha256"},
    "surfaceReconciliationDigest": {"$ref": "#/$defs/sha256"},
    "targetEnvironment": {"type": "string", "minLength": 2, "maxLength": 64},
    "targetUrl": {"type": ["string", "null"], "maxLength": 2000},
    "surfaces": {"type": "array", "minItems": 1, "maxItems": 22, "uniqueItems": true, "items": {"type": "string"}},
    "profileOwner": {"type": "string", "minLength": 1, "maxLength": 200},
    "profileReferenceDigest": {"$ref": "#/$defs/sha256"},
    "controlResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 47,
      "items": {"$ref": "#/$defs/controlResult"}
    },
    "activeWaivers": {"type": "array", "maxItems": 47, "items": {"type": "object"}},
    "complete": {"type": "boolean"},
    "passed": {"type": "boolean"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "serverSession": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "issuedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "riskTier": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "requirementResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "status", "evidenceCount", "passingEvidenceCount", "distinctProducerCount", "independentEvidencePresent", "evidenceReceiptDigests", "detail"],
      "properties": {
        "requirementId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
        "status": {"type": "string", "enum": ["pass", "fail", "incomplete", "not-applicable"]},
        "evidenceCount": {"type": "integer", "minimum": 0, "maximum": 300},
        "passingEvidenceCount": {"type": "integer", "minimum": 0, "maximum": 300},
        "distinctProducerCount": {"type": "integer", "minimum": 0, "maximum": 300},
        "independentEvidencePresent": {"type": "boolean"},
        "evidenceReceiptDigests": {"type": "array", "maxItems": 300, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "detail": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "controlResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlId", "sequence", "category", "gateLevel", "status", "evidenceReceiptDigests", "requirementResults", "waiverDigest"],
      "properties": {
        "controlId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 47},
        "category": {"type": "string", "enum": ["security", "email", "findability", "speed", "analytics", "legal", "final-test"]},
        "gateLevel": {"type": "string", "enum": ["blocker", "required", "advisory"]},
        "status": {"type": "string", "enum": ["pass", "fail", "incomplete", "not-applicable", "waived"]},
        "evidenceReceiptDigests": {"type": "array", "maxItems": 300, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "requirementResults": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/requirementResult"}},
        "waiverDigest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    }
  }
}
