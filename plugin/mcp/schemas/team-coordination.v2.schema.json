{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.local/schemas/team-coordination.v2.schema.json",
  "title": "JStack Dynamic Team Coordination Packet v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "teamPlanId",
    "teamPlanDigest",
    "mode",
    "requestedTaskMode",
    "physicalAgents",
    "fileOwnershipMap",
    "evidenceContractIds",
    "conflictRule",
    "stopConditions",
    "verificationGate",
    "handoffGate",
    "authorityEffect"
  ],
  "properties": {
    "schemaVersion": {
      "const": "jstack.team-coordination.v2"
    },
    "teamPlanId": {
      "type": "string",
      "pattern": "^team-plan-[A-Za-z0-9TZ-]+-[0-9a-f]{12}$",
      "maxLength": 100
    },
    "teamPlanDigest": {
      "$ref": "#/$defs/sha256"
    },
    "mode": {
      "enum": [
        "single-lead",
        "smart-subagents",
        "full-team"
      ]
    },
    "requestedTaskMode": {
      "enum": [
        "explain",
        "research",
        "plan-only",
        "read-only-audit",
        "diagnose-only",
        "implement",
        "test",
        "review",
        "fix",
        "commit",
        "push",
        "open-pull-request",
        "merge",
        "deploy",
        "modify-production",
        "external-action"
      ]
    },
    "physicalAgents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/physicalAgent"
      }
    },
    "fileOwnershipMap": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^agent-(?:primary|independent-[1-9][0-9]*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/scopeList"
      }
    },
    "evidenceContractIds": {
      "$ref": "#/$defs/identifierList"
    },
    "conflictRule": {
      "$ref": "#/$defs/boundedText"
    },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/boundedText"
      }
    },
    "verificationGate": {
      "$ref": "#/$defs/boundedText"
    },
    "handoffGate": {
      "$ref": "#/$defs/boundedText"
    },
    "authorityEffect": {
      "const": "none"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "identifierList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "scopeList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "physicalAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalAgentId",
        "specialistIds",
        "canonicalRoleIds",
        "independentFromPhysicalAgentIds"
      ],
      "properties": {
        "physicalAgentId": {
          "type": "string",
          "pattern": "^agent-(?:primary|independent-[1-9][0-9]*)$"
        },
        "specialistIds": {
          "$ref": "#/$defs/identifierList"
        },
        "canonicalRoleIds": {
          "$ref": "#/$defs/identifierList"
        },
        "independentFromPhysicalAgentIds": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^agent-(?:primary|independent-[1-9][0-9]*)$"
          }
        }
      }
    }
  }
}
