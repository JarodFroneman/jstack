{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.dev/schemas/ui-evidence.v1.schema.json",
  "title": "JStack Product Interface evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractSha256",
    "catalogSha256",
    "candidate",
    "producer",
    "capturedAt",
    "complete",
    "truncated",
    "captures",
    "checks",
    "productObservations",
    "humanAestheticApproval",
    "manifestSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "jstack.ui.evidence.v1"},
    "contractSha256": {"$ref": "#/$defs/sha256"},
    "catalogSha256": {"$ref": "#/$defs/sha256"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "producer": {"$ref": "#/$defs/producer"},
    "capturedAt": {"$ref": "#/$defs/timestamp"},
    "complete": {"const": true},
    "truncated": {"const": false},
    "captures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capture"}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/check"}
    },
    "productObservations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/productObservation"}
    },
    "humanAestheticApproval": {"$ref": "#/$defs/humanApprovalAbsent"},
    "manifestSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"},
    "profile": {"type": "string", "enum": ["editorial-calm", "creative-canvas"]},
    "platform": {
      "type": "string",
      "enum": ["web", "webview", "ios", "android", "react-native", "flutter", "electron", "tauri", "macos", "windows", "linux"]
    },
    "theme": {"type": "string", "enum": ["light", "dark"]},
    "state": {
      "type": "string",
      "enum": ["normal", "hover", "focus", "pressed", "loading", "empty", "error", "disabled", "selected", "success", "destructive"]
    },
    "timestamp": {"type": "string", "format": "date-time", "minLength": 1, "maxLength": 100},
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "allOf": [
        {"pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,499}$"},
        {"not": {"pattern": "(^|/)\\.{1,2}(/|$)|//|/$"}}
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitHead",
        "treeSha256",
        "projectFingerprint",
        "buildCommandKey",
        "buildCommandSha256",
        "buildSha256",
        "runtimeSha256"
      ],
      "properties": {
        "gitHead": {"$ref": "#/$defs/gitOid"},
        "treeSha256": {"$ref": "#/$defs/sha256"},
        "projectFingerprint": {"$ref": "#/$defs/sha256"},
        "buildCommandKey": {"type": "string", "minLength": 1, "maxLength": 200},
        "buildCommandSha256": {"$ref": "#/$defs/sha256"},
        "buildSha256": {"$ref": "#/$defs/sha256"},
        "runtimeSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "os", "device"],
      "properties": {
        "tool": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "os": {"type": "string", "minLength": 1, "maxLength": 200},
        "device": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "evidenceCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "platform", "theme", "viewportId", "state"],
      "properties": {
        "surfaceId": {"$ref": "#/$defs/identifier"},
        "platform": {"$ref": "#/$defs/platform"},
        "theme": {"$ref": "#/$defs/theme"},
        "viewportId": {"$ref": "#/$defs/identifier"},
        "state": {"$ref": "#/$defs/state"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "width", "height", "dpr", "metadataStripped"],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 25000000},
        "width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height": {"type": "integer", "minimum": 1, "maximum": 16384},
        "dpr": {"type": "number", "exclusiveMinimum": 0},
        "metadataStripped": {"const": true}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell", "artifact", "buildSha256", "runtimeSha256", "producerSha256"],
      "properties": {
        "cell": {"$ref": "#/$defs/evidenceCell"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "buildSha256": {"$ref": "#/$defs/sha256"},
        "runtimeSha256": {"$ref": "#/$defs/sha256"},
        "producerSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "platform", "surfaceId", "status", "producer", "observedAt", "resultSha256", "resultArtifact"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 100},
        "kind": {
          "type": "string",
          "enum": ["critical-flow", "keyboard-focus", "accessibility", "reduced-motion", "text-fit-overflow"]
        },
        "platform": {"$ref": "#/$defs/platform"},
        "surfaceId": {"$ref": "#/$defs/identifier"},
        "status": {"const": "pass"},
        "producer": {"type": "string", "minLength": 1, "maxLength": 200},
        "observedAt": {"$ref": "#/$defs/timestamp"},
        "resultSha256": {"$ref": "#/$defs/sha256"},
        "resultArtifact": {"$ref": "#/$defs/resultArtifact"}
      }
    },
    "resultArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "mediaType"],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 5000000},
        "mediaType": {"const": "application/json"}
      }
    },
    "productObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "profile", "reviewerType", "reviewerIdSha256", "status", "observedAt", "findingId", "category", "severity", "buildSha256", "runtimeSha256", "producerSha256", "observationSha256", "observationArtifact"],
      "properties": {
        "surfaceId": {"$ref": "#/$defs/identifier"},
        "profile": {"$ref": "#/$defs/profile"},
        "reviewerType": {"const": "agent"},
        "reviewerIdSha256": {"$ref": "#/$defs/sha256"},
        "status": {"type": "string", "enum": ["pass", "advisory", "blocker"]},
        "observedAt": {"$ref": "#/$defs/timestamp"},
        "findingId": {"type": "string", "minLength": 1, "maxLength": 100},
        "category": {
          "type": "string",
          "enum": ["hierarchy", "coherence", "responsiveness", "accessibility", "platform-fit", "generic-ai-styling", "other"]
        },
        "severity": {"type": "string", "enum": ["info", "advisory", "blocker"]},
        "buildSha256": {"$ref": "#/$defs/sha256"},
        "runtimeSha256": {"$ref": "#/$defs/sha256"},
        "producerSha256": {"$ref": "#/$defs/sha256"},
        "observationSha256": {"$ref": "#/$defs/sha256"},
        "observationArtifact": {"$ref": "#/$defs/observationArtifact"}
      }
    },
    "observationArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "mediaType"],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "mediaType": {"const": "application/json"}
      }
    },
    "humanApprovalAbsent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provided", "reviewerIdSha256", "observedAt", "approvalSha256"],
      "properties": {
        "provided": {"const": false},
        "reviewerIdSha256": {"type": "null"},
        "observedAt": {"type": "null"},
        "approvalSha256": {"type": "null"}
      }
    }
  }
}
