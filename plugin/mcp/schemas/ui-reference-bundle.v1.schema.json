{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstack.dev/schemas/ui-reference-bundle.v1.schema.json",
  "title": "JStack Product Interface private reference bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractSha256",
    "createdAt",
    "complete",
    "truncated",
    "sources",
    "analysisArtifact",
    "prototypes",
    "selectedPrototypeId",
    "manifestSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "jstack.ui.reference-bundle.v1"},
    "contractSha256": {"$ref": "#/$defs/sha256"},
    "createdAt": {"type": "string", "format": "date-time"},
    "complete": {"const": true},
    "truncated": {"const": false},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source"}
    },
    "analysisArtifact": {"$ref": "#/$defs/jsonArtifact"},
    "prototypes": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/prototype"}
    },
    "selectedPrototypeId": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/identifier"}
      ]
    },
    "manifestSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"},
    "safePath": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,499}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "mediaType"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 25000000},
        "mediaType": {"enum": ["image/png", "image/jpeg", "image/webp", "application/json", "text/html"]}
      }
    },
    "imageArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"mediaType": {"enum": ["image/png", "image/jpeg", "image/webp"]}}}
      ]
    },
    "pngArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"mediaType": {"const": "image/png"}}}
      ]
    },
    "jsonArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"mediaType": {"const": "application/json"}, "size": {"maximum": 1000000}}}
      ]
    },
    "htmlArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"mediaType": {"const": "text/html"}, "size": {"maximum": 2000000}}}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "artifact", "width", "height", "viewportId",
        "sourceUrlSha256", "captureAuthority", "rightsBasis", "sensitiveData",
        "metadataStripped", "externalProcessing", "providerDisclosure"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["screenshot", "url-capture", "figma-export"]},
        "artifact": {"$ref": "#/$defs/imageArtifact"},
        "width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height": {"type": "integer", "minimum": 1, "maximum": 16384},
        "viewportId": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "sourceUrlSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "captureAuthority": {"oneOf": [{"type": "null"}, {"const": "user-approved-exact-url"}]},
        "rightsBasis": {"enum": ["owned", "authorized", "reference-only"]},
        "sensitiveData": {"enum": ["none", "redacted", "approved"]},
        "metadataStripped": {"const": true},
        "externalProcessing": {"type": "boolean"},
        "providerDisclosure": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 1000}]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "url-capture"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "viewportId": {"$ref": "#/$defs/identifier"},
              "sourceUrlSha256": {"$ref": "#/$defs/sha256"},
              "captureAuthority": {"const": "user-approved-exact-url"}
            }
          },
          "else": {
            "properties": {
              "sourceUrlSha256": {"type": "null"},
              "captureAuthority": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"externalProcessing": {"const": true}}, "required": ["externalProcessing"]},
          "then": {"properties": {"providerDisclosure": {"type": "string", "minLength": 1, "maxLength": 1000}}},
          "else": {"properties": {"providerDisclosure": {"type": "null"}}}
        }
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "provider", "externalProcessing", "providerDisclosure"],
      "properties": {
        "tool": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "provider": {"type": "string", "minLength": 1, "maxLength": 200},
        "externalProcessing": {"type": "boolean"},
        "providerDisclosure": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 1000}]}
      },
      "allOf": [
        {
          "if": {"properties": {"externalProcessing": {"const": true}}, "required": ["externalProcessing"]},
          "then": {"properties": {"providerDisclosure": {"type": "string", "minLength": 1, "maxLength": 1000}}},
          "else": {"properties": {"providerDisclosure": {"type": "null"}}}
        }
      ]
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewportId", "artifact", "isolated", "networkAccess"],
      "properties": {
        "viewportId": {"$ref": "#/$defs/identifier"},
        "artifact": {"$ref": "#/$defs/pngArtifact"},
        "isolated": {"const": true},
        "networkAccess": {"const": false}
      }
    },
    "prototype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "generator", "htmlArtifact", "renders"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "target": {"enum": ["html-css", "html-tailwind"]},
        "generator": {"$ref": "#/$defs/generator"},
        "htmlArtifact": {"$ref": "#/$defs/htmlArtifact"},
        "renders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/render"}
        }
      }
    }
  }
}
