{
  "schemaVersion": "jstack.ui.motion-catalog.v1",
  "catalogVersion": "1.0.0",
  "principles": [
    "A control responds immediately enough to acknowledge input before a longer state or navigation transition begins.",
    "Motion preserves spatial continuity between related states and makes origin, destination, hierarchy, and causality understandable.",
    "Acceleration, deceleration, and spring behavior remain restrained and appropriate to the product rather than decorative.",
    "Exits are normally faster or quieter than entrances and never make the user wait for an interaction target to become available.",
    "Interactions remain interruption-safe and reversible when the underlying product action is reversible.",
    "Interaction frequency and input modality determine how much motion is useful; repeated and keyboard-driven work stays near-instant.",
    "Motion never carries state meaning alone and always has an explicit reduced-motion substitution.",
    "Existing project conventions and platform-native facilities take precedence over introducing another animation runtime."
  ],
  "tokens": {
    "durationMs": {
      "instant": 0,
      "press": 80,
      "fast": 120,
      "standard": 180,
      "spatial": 240,
      "deliberate": 320
    },
    "easing": {
      "linear": "linear",
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "springs": {
      "settle": {
        "character": "subtle-settle",
        "mass": 1.0,
        "stiffness": 360,
        "damping": 34
      },
      "spatial": {
        "character": "restrained-spatial",
        "mass": 1.0,
        "stiffness": 300,
        "damping": 32
      }
    },
    "distancePx": {
      "none": 0,
      "micro": 2,
      "small": 4,
      "medium": 8,
      "large": 16
    },
    "scale": {
      "identity": 1.0,
      "press": 0.98,
      "subtle-in": 0.985
    },
    "opacity": {
      "hidden": 0.0,
      "softened": 0.72,
      "visible": 1.0
    },
    "blurPx": {
      "none": 0,
      "subtle": 4,
      "maximum": 8
    },
    "staggerMs": {
      "none": 0,
      "tight": 20,
      "maximum": 40
    },
    "overlay": {
      "maximumBackdropOpacity": 0.48,
      "zAxisPolicy": "Use the established semantic layer scale; transient controls remain above their origin and below blocking dialogs."
    },
    "reducedMotion": {
      "maximumDurationMs": 120,
      "spatialDistancePx": 0,
      "scaleChangeAllowed": false,
      "blurAllowed": false,
      "repeatedMotionAllowed": false
    }
  },
  "frequencyPolicies": [
    {
      "id": "rare",
      "spatialMotionAllowed": true,
      "maximumDurationToken": "deliberate",
      "defaultCharacter": "Purposeful spatial continuity is allowed when it improves orientation."
    },
    {
      "id": "routine",
      "spatialMotionAllowed": true,
      "maximumDurationToken": "spatial",
      "defaultCharacter": "Use restrained state and spatial transitions without delaying the next action."
    },
    {
      "id": "frequent",
      "spatialMotionAllowed": false,
      "maximumDurationToken": "fast",
      "defaultCharacter": "Use immediate feedback and omit nonessential travel, stagger, blur, and overshoot."
    },
    {
      "id": "continuous",
      "spatialMotionAllowed": false,
      "maximumDurationToken": "instant",
      "defaultCharacter": "Follow input directly; animate only a necessary settle or progress signal after input ends."
    }
  ],
