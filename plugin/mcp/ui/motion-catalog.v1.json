  "antiPatterns": [
    "Do not scale every hovered control or card.",
    "Do not pulse, shimmer, bounce, or loop without a necessary progress, attention, or system-status purpose.",
    "Do not stagger ordinary page content or replay entrance animation after routine state updates.",
    "Do not apply one fade-on-mount recipe to every conditional render.",
    "Do not add parallax, zoom, blur, long travel, or elastic overshoot to high-frequency utility work.",
    "Do not animate layout properties when stable geometry, transforms, opacity, clipping, or an explicit state change can communicate the result."
  ],
  "requirements": {
