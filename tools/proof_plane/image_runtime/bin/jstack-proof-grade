#!/usr/bin/python3
"""Run one sealed Beta.1 holdout without exposing it to candidate code.

The grader is installed verbatim in every qualified image.  It accepts one
fixed bundle path, implements a closed task-to-adapter registry, and emits one
canonical ``jstack.eval.grader-observation.v1`` object.  Bundle data never
selects an executable, argv, import, module, environment, or working directory.

Candidate code is exercised only in a second bubblewrap namespace whose root
contains the fixed toolchain, a disposable source copy, and a reviewed adapter
harness.  The outer ``/sealed/holdout.bundle`` mount is deliberately absent.
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path, PurePosixPath
from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple


VERSION = "jstack-proof-grader-v1"
BUNDLE_SCHEMA = "jstack.eval.private-holdout-bundle.v1"
ADAPTER_VERSION = "jstack-proof-holdout-adapter-v1"
OBSERVATION_SCHEMA = "jstack.eval.grader-observation.v1"
BASELINE_OBSERVATION_SCHEMA = "jstack.eval.baseline-execution-observation.v1"
ADAPTER_CASE_CONTRACT_VERSION = "jstack-proof-adapter-case-contract-v1"
EMPTY_PATCH_SHA256 = hashlib.sha256(b"").hexdigest()
GRADER_PATH = Path("/usr/local/bin/jstack-proof-grade")
BUNDLE_PATH = Path("/sealed/holdout.bundle")
WORKSPACE_PATH = Path("/workspace")
GIT_DIRECTORY_PATH = Path("/proof-git")
GIT_PATH = Path("/usr/bin/git")
BWRAP_PATH = Path("/usr/bin/bwrap")

MAX_BUNDLE_BYTES = 5_000_000
MAX_OUTPUT_BYTES = 5_000_000
MAX_SOURCE_FILES = 20_000
MAX_SOURCE_BYTES = 500_000_000
COMMAND_TIMEOUT_SECONDS = 600
CASE_TIMEOUT_SECONDS = 300
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
GIT_SHA1_RE = re.compile(r"^[0-9a-f]{40}$")
IDENTIFIER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")
DATA_KEY_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$")
CASE_CATEGORIES = frozenset(("boundary", "invariant", "regression", "sanitizer", "security", "target"))
ASSERTIONS = frozenset(("equals", "is-false", "is-non-null", "is-null", "is-true", "not-equals"))
FORBIDDEN_DATA_KEYS = frozenset(
    (
        "argv", "args", "binary", "callable", "class", "cmd", "command", "cwd",
        "env", "environment", "entrypoint", "eval", "exec", "executable",
        "function", "import", "loader", "module", "process", "program", "script",
        "shell", "subprocess", "working_directory", "workingdirectory",
    )
)

ADAPTER_OUTPUT_CONTRACTS = {
    "hono-json-media": ("object(status:http-status,value:safe-json)", ("equals",)),
    "typescript-redirect": ("string", ("equals",)),
    "typescript-profile": ("string", ("equals",)),
    "python-transfer": ("array(transfer-record)-matching-operation-count", ("equals",)),
    "python-webhook": ("boolean", ("equals", "is-false", "is-true")),
    "starlette-url-replace": ("url-record-or-fixed-failure-record", ("equals",)),
    "nanohttpd-response": ("http-response-record-or-fixed-failure-record", ("equals",)),
    "csharp-tenant-document": ("tenant-document-or-null", ("equals", "is-null")),
    "csharp-profile": ("profile-record-or-error-record", ("equals",)),
    "c-frame": ("frame-result-matching-output-capacity", ("equals",)),
    "c-decimal": ("decimal-result", ("equals",)),
    "tinyxml2-character-reference": ("input-selected-boolean-integer-string-or-null", ("equals", "is-false", "is-null", "is-true")),
    "python-documents": ("array(document-record)", ("equals",)),
    "python-users": ("array(user-record)", ("equals",)),
    "sqlite-utils-foreign-key": ("foreign-key-result-or-fixed-failure-record", ("equals",)),
    "linenoise-history-resize": ("input-selected-boolean-or-string-array-or-null", ("equals", "is-false", "is-null", "is-true")),
    "legacy-config": ("legacy-config-result", ("equals",)),
    "legacy-token": ("boolean", ("equals", "is-false", "is-true")),
}


def _task(
    family: str,
    kind: str,
    adapter: str,
    allowed: Sequence[str],
    maximum_files: int,
    public_commands: Sequence[Sequence[str]],
    sanitizer_commands: Sequence[Sequence[str]] = (),
) -> Dict[str, Any]:
    return {
        "family": family,
        "kind": kind,
        "adapter": adapter,
        "allowed": tuple(allowed),
        "forbidden": ("proof-holdout", "hidden-tests", ".git"),
        "maximumFiles": maximum_files,
        "publicCommands": tuple(tuple(item) for item in public_commands),
        "sanitizerCommands": tuple(tuple(item) for item in sanitizer_commands),
    }


