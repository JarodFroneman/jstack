NANOHTTPD_RESPONSE = r'''import json, struct, subprocess, sys

TRANSFER = {"fixed": 0, "chunked": 1, "head": 2}

def run_case(item):
    body = item["bodyUtf8"].encode("utf-8")
    explicit = -1 if item["explicitContentLength"] is None else item["explicitContentLength"]
    payload = struct.pack(">IqBB", len(body), explicit, TRANSFER[item["transfer"]], int(item["gzip"])) + body
    try:
        process = subprocess.run(
            ["/workspace/.jstack-grader/nanohttpd/NanoDriver"],
            input=payload,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        process = None
    failed = {
        "bodyHex": None,
        "completed": False,
        "contentLengthValues": [],
        "statusLine": None,
        "transferEncodingValues": [],
    }
    if process is None or process.returncode != 0 or process.stderr or len(process.stdout) > 1_000_000:
        return failed
    try:
        header, body_bytes = process.stdout.split(b"\r\n\r\n", 1)
        lines = header.decode("latin-1").split("\r\n")
        if not lines or not lines[0].startswith("HTTP/1.1 "):
            return failed
        content_lengths = []
        transfer_encodings = []
        for line in lines[1:]:
            name, separator, value = line.partition(":")
            if separator != ":":
                return failed
            if name.lower() == "content-length":
                content_lengths.append(value.strip())
            if name.lower() == "transfer-encoding":
                transfer_encodings.append(value.strip())
        return {
            "bodyHex": body_bytes.hex(),
            "completed": True,
            "contentLengthValues": content_lengths,
            "statusLine": lines[0],
            "transferEncodingValues": transfer_encodings,
        }
    except (UnicodeError, ValueError):
        return failed

inputs = json.load(sys.stdin)
sys.stdout.write(json.dumps([run_case(item) for item in inputs], sort_keys=True, separators=(",", ":")) + "\n")
'''

NANOHTTPD_DRIVER = r'''// Fixed JStack behavioral harness; upstream NanoHTTPD remains BSD-3-Clause.
import java.io.ByteArrayInputStream;
import java.io.ByteArrayOutputStream;
import java.io.DataInputStream;
import java.nio.charset.StandardCharsets;
import org.nanohttpd.protocols.http.request.Method;
import org.nanohttpd.protocols.http.response.Response;
import org.nanohttpd.protocols.http.response.Status;

public final class NanoDriver {
    public static void main(String[] args) throws Exception {
        if (args.length != 0) {
            System.exit(2);
        }
        DataInputStream input = new DataInputStream(System.in);
        int length = input.readInt();
        long explicitLength = input.readLong();
        int transfer = input.readUnsignedByte();
        boolean gzip = input.readBoolean();
        if (length < 0 || length > 32768 || explicitLength < -1 || transfer < 0 || transfer > 2) {
            System.exit(2);
        }
        byte[] body = new byte[length];
        input.readFully(body);
        if (input.read() != -1) {
            System.exit(2);
        }
        Response response = transfer == 1
            ? Response.newChunkedResponse(Status.OK, "application/octet-stream", new ByteArrayInputStream(body))
            : Response.newFixedLengthResponse(Status.OK, "application/octet-stream", body);
        response.setRequestMethod(transfer == 2 ? Method.HEAD : Method.GET);
        response.setUseGzip(gzip);
        if (explicitLength >= 0) {
            response.addHeader("Content-Length", Long.toString(explicitLength));
        }
        ByteArrayOutputStream output = new ByteArrayOutputStream();
        response.send(output);
        System.out.write(output.toByteArray());
    }
}
'''

TINYXML2_CHARACTER_REFERENCE = r'''import json, struct, subprocess, sys

def run_case(item):
    try:
        process = subprocess.run(
            ["/workspace/.jstack-grader/tinyxml2/driver"],
            input=item["xml"].encode("utf-8"),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        process = None
    completed = process is not None and process.returncode == 0 and not process.stderr
    error_code = None
    text = None
    if completed:
        raw = process.stdout
        if len(raw) < 8:
            completed = False
        else:
            error_code, text_length = struct.unpack(">II", raw[:8])
            if text_length == 0xFFFFFFFF:
                if len(raw) != 8:
                    completed = False
            elif text_length > 32768 or len(raw) != 8 + text_length:
                completed = False
            else:
                try:
                    text = raw[8:].decode("utf-8")
                except UnicodeError:
                    completed = False
    if item["observe"] == "completed":
        return completed
    if item["observe"] == "error-code":
        return error_code if completed else None
    return text if completed and error_code == 0 else None

inputs = json.load(sys.stdin)
sys.stdout.write(json.dumps([run_case(item) for item in inputs], sort_keys=True, separators=(",", ":")) + "\n")
'''

TINYXML2_DRIVER = r'''// Fixed JStack behavioral harness; upstream tinyxml2 remains Zlib licensed.
#include "tinyxml2.h"
#include <cstdint>
#include <iostream>
#include <iterator>
#include <string>

static void write_u32(std::uint32_t value) {
    const unsigned char bytes[4] = {
        static_cast<unsigned char>((value >> 24) & 0xff),
        static_cast<unsigned char>((value >> 16) & 0xff),
        static_cast<unsigned char>((value >> 8) & 0xff),
        static_cast<unsigned char>(value & 0xff),
    };
    std::cout.write(reinterpret_cast<const char*>(bytes), 4);
}

int main(int argc, char** argv) {
    if (argc != 1) return 2;
    std::string xml((std::istreambuf_iterator<char>(std::cin)), std::istreambuf_iterator<char>());
    if (xml.size() > 32768) return 2;
    tinyxml2::XMLDocument document;
    const tinyxml2::XMLError error = document.Parse(xml.c_str(), xml.size());
    const tinyxml2::XMLElement* root = document.RootElement();
    const char* text = root == 0 ? 0 : root->GetText();
    write_u32(static_cast<std::uint32_t>(error));
    if (text == 0) {
        write_u32(UINT32_MAX);
    } else {
        const std::string value(text);
        if (value.size() > 32768) return 2;
        write_u32(static_cast<std::uint32_t>(value.size()));
        std::cout.write(value.data(), static_cast<std::streamsize>(value.size()));
    }
    return std::cout.good() ? 0 : 2;
}
'''

SQLITE_UTILS_FOREIGN_KEY = r'''import json, sqlite3, sys
sys.path.insert(0, "/workspace")
from sqlite_utils import Database

def quote_identifier(value):
    return '"' + value.replace('"', '""') + '"'

def run_case(item):
    connection = sqlite3.connect(":memory:")
    failed = {"completed": False, "foreignKeys": [], "integrity": None, "rows": []}
    try:
        other_table = item["otherTableName"]
        other_column = item["otherColumnName"]
        column = item["columnName"]
        connection.execute(
            "CREATE TABLE {} ({} INTEGER PRIMARY KEY, value TEXT NOT NULL)".format(
                quote_identifier(other_table), quote_identifier(other_column)
            )
        )
        connection.execute(
            "CREATE TABLE items (id INTEGER PRIMARY KEY, {} INTEGER NOT NULL)".format(
                quote_identifier(column)
            )
        )
        connection.execute(
            "INSERT INTO {} ({}, value) VALUES (?, ?)".format(
                quote_identifier(other_table), quote_identifier(other_column)
            ),
            (1, "parent"),
        )
        connection.execute(
            "INSERT INTO items (id, {}) VALUES (?, ?)".format(quote_identifier(column)),
            (7, 1),
        )
        database = Database(connection)
        database.add_foreign_keys([("items", column, other_table, other_column)])
        foreign_keys = [
            {"column": value.column, "otherColumn": value.other_column, "otherTable": value.other_table}
            for value in database["items"].foreign_keys
        ]
        foreign_keys.sort(key=lambda value: (value["column"], value["otherTable"], value["otherColumn"]))
        rows = [
            list(value)
            for value in connection.execute(
                "SELECT id, {} FROM items ORDER BY id".format(quote_identifier(column))
            ).fetchall()
        ]
        integrity = connection.execute("PRAGMA integrity_check").fetchone()[0]
        return {"completed": True, "foreignKeys": foreign_keys, "integrity": integrity, "rows": rows}
    except Exception:
        return failed
    finally:
        connection.close()

inputs = json.load(sys.stdin)
sys.stdout.write(json.dumps([run_case(item) for item in inputs], sort_keys=True, separators=(",", ":")) + "\n")
'''

LINENOISE_HISTORY_RESIZE = r'''import json, struct, subprocess, sys

def run_case(item):
    entries = [value.encode("utf-8") for value in item["entries"]]
    payload = struct.pack(">III", item["initialMaximum"], item["newMaximum"], len(entries))
    for value in entries:
        payload += struct.pack(">I", len(value)) + value
    try:
        process = subprocess.run(
            ["/workspace/.jstack-grader/linenoise/driver"],
            input=payload,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        process = None
    completed = process is not None and process.returncode == 0 and not process.stderr and len(process.stdout) <= 1_000_000
    if item["observe"] == "completed":
        return completed
    if not completed:
        return None
    try:
        text = process.stdout.decode("utf-8")
    except UnicodeError:
        return None
    if text and not text.endswith("\n"):
        return None
    return text.splitlines()

inputs = json.load(sys.stdin)
sys.stdout.write(json.dumps([run_case(item) for item in inputs], sort_keys=True, separators=(",", ":")) + "\n")
'''

LINENOISE_DRIVER = r'''/* Fixed JStack behavioral harness; upstream linenoise remains BSD-2-Clause. */
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "linenoise.h"

extern char **history;

static int read_u32(uint32_t *value) {
    unsigned char bytes[4];
    if (fread(bytes, 1, 4, stdin) != 4) return 0;
    *value = ((uint32_t)bytes[0] << 24) | ((uint32_t)bytes[1] << 16) |
             ((uint32_t)bytes[2] << 8) | (uint32_t)bytes[3];
    return 1;
}

int main(int argc, char **argv) {
    uint32_t initial_maximum, new_maximum, count, index;
    const char *output_path = "/tmp/jstack-linenoise-history.txt";
    FILE *output;
    unsigned char buffer[4096];
    size_t read_count;
    uint32_t retained;
    (void)argv;
    if (argc != 1 || !read_u32(&initial_maximum) || !read_u32(&new_maximum) || !read_u32(&count)) return 2;
    if (initial_maximum < 1 || initial_maximum > 1024 || new_maximum < 1 || new_maximum > 1024 || count < 1 || count > 64) return 2;
    if (!linenoiseHistorySetMaxLen((int)initial_maximum)) return 2;
    for (index = 0; index < count; ++index) {
        uint32_t length;
        char *entry;
        if (!read_u32(&length) || length > 32768) return 2;
        entry = (char*)malloc((size_t)length + 1);
        if (entry == NULL) return 2;
        if (length && fread(entry, 1, length, stdin) != length) {
            free(entry);
            return 2;
        }
        entry[length] = '\0';
        if (!linenoiseHistoryAdd(entry)) {
            free(entry);
            return 2;
        }
        free(entry);
    }
    if (fgetc(stdin) != EOF || !linenoiseHistorySetMaxLen((int)new_maximum)) return 2;
    if (linenoiseHistorySave((char*)output_path) != 0) return 2;
    output = fopen(output_path, "rb");
    if (output == NULL) return 2;
    while ((read_count = fread(buffer, 1, sizeof(buffer), output)) != 0) {
        if (fwrite(buffer, 1, read_count, stdout) != read_count) {
            fclose(output);
            return 2;
        }
    }
    if (ferror(output) || fclose(output) != 0 || remove(output_path) != 0) return 2;
    retained = count < initial_maximum ? count : initial_maximum;
    if (retained > new_maximum) retained = new_maximum;
    for (index = 0; index < retained; ++index) free(history[index]);
    free(history);
    history = NULL;
    return fflush(stdout) == 0 ? 0 : 2;
}
'''


def _adapter_assets(
    adapter: str,
) -> Tuple[Tuple[Tuple[str, str, str], ...], Tuple[Tuple[str, ...], ...], Tuple[str, ...]]:
    """Return fixed (location, filename, source) assets and fixed commands."""

    def runner(filename: str, source: str, command: Sequence[str]):
        return (("runner", filename, source),), (), tuple(command)

    if adapter == "typescript-redirect":
        return runner("adapter.mjs", TYPESCRIPT_REDIRECT, ("/usr/bin/node", "--experimental-strip-types", "/runner/adapter.mjs"))
    if adapter == "typescript-profile":
        return runner("adapter.mjs", TYPESCRIPT_PROFILE, ("/usr/bin/node", "--experimental-strip-types", "/runner/adapter.mjs"))
    if adapter == "python-transfer":
        return runner("adapter.py", PYTHON_TRANSFER, ("/usr/bin/python3", "/runner/adapter.py"))
    if adapter == "python-webhook":
        return runner("adapter.py", PYTHON_WEBHOOK, ("/usr/bin/python3", "/runner/adapter.py"))
    if adapter == "python-documents":
        return runner("adapter.py", PYTHON_DOCUMENTS, ("/usr/bin/python3", "/runner/adapter.py"))
    if adapter == "python-users":
        return runner("adapter.py", PYTHON_USERS, ("/usr/bin/python3", "/runner/adapter.py"))
    if adapter == "c-frame":
        return (
            (("runner", "adapter.py", C_FRAME),),
            (("/usr/bin/mkdir", "-p", ".jstack-grader"),
             ("/usr/bin/cc", "-std=c11", "-shared", "-fPIC", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-I", "include", "src/frame_decoder.c", "-o", ".jstack-grader/libtarget.so")),
            ("/usr/bin/python3", "/runner/adapter.py"),
        )
    if adapter == "c-decimal":
        return (
            (("runner", "adapter.py", C_DECIMAL),),
            (("/usr/bin/mkdir", "-p", ".jstack-grader"),
             ("/usr/bin/cc", "-std=c11", "-shared", "-fPIC", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-I", "include", "src/decimal_counter.c", "-o", ".jstack-grader/libtarget.so")),
            ("/usr/bin/python3", "/runner/adapter.py"),
        )
    if adapter == "legacy-config":
        return (
            (("runner", "adapter.py", LEGACY_CONFIG),),
            (("/usr/bin/mkdir", "-p", ".jstack-grader"),
             ("/usr/bin/cc", "-std=c89", "-shared", "-fPIC", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-I", "include", "src/legacy_config.c", "-o", ".jstack-grader/libtarget.so")),
            ("/usr/bin/python3", "/runner/adapter.py"),
        )
    if adapter == "legacy-token":
        return (
            (("runner", "adapter.py", LEGACY_TOKEN),),
            (("/usr/bin/mkdir", "-p", ".jstack-grader"),
             ("/usr/bin/cc", "-std=c89", "-shared", "-fPIC", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-I", "include", "src/legacy_token.c", "-o", ".jstack-grader/libtarget.so")),
            ("/usr/bin/python3", "/runner/adapter.py"),
        )
    if adapter in ("csharp-tenant-document", "csharp-profile"):
        if adapter == "csharp-tenant-document":
            project = "/workspace/src/TenantDocuments.csproj"
            source = CSHARP_TENANT_DOCUMENT
        else:
            project = "/workspace/src/ProfileUpdates.csproj"
            source = CSHARP_PROFILE
        project_text = """<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net8.0</TargetFramework>\n    <ImplicitUsings>disable</ImplicitUsings>\n    <Nullable>enable</Nullable>\n    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>\n  </PropertyGroup>\n  <ItemGroup><ProjectReference Include=\"%s\" /></ItemGroup>\n</Project>\n""" % project
        return (
            (
                ("source", ".jstack-grader/Program.cs", source),
                ("source", ".jstack-grader/Adapter.csproj", project_text),
            ),
            (),
            ("/usr/bin/dotnet", "run", "--project", "/workspace/.jstack-grader/Adapter.csproj", "--configuration", "Release"),
        )
    if adapter == "hono-json-media":
        return runner("adapter.ts", HONO_JSON_MEDIA, ("/usr/local/bin/bun", "/runner/adapter.ts"))
    if adapter == "starlette-url-replace":
        return runner("adapter.py", STARLETTE_URL_REPLACE, ("/usr/bin/python3", "/runner/adapter.py"))
    if adapter == "nanohttpd-response":
        return (
            (
                ("runner", "adapter.py", NANOHTTPD_RESPONSE),
                ("runner", "NanoDriver.java", NANOHTTPD_DRIVER),
            ),
            (("/usr/bin/mkdir", "-p", ".jstack-grader/nanohttpd"),
             ("/usr/bin/javac", "-encoding", "UTF-8", "-d", ".jstack-grader/nanohttpd", "-sourcepath", "core/src/main/java", "/runner/NanoDriver.java")),
            ("/usr/bin/python3", "/runner/adapter.py"),
        )
    if adapter == "tinyxml2-character-reference":
        return (
            (
                ("runner", "adapter.py", TINYXML2_CHARACTER_REFERENCE),
                ("runner", "tinyxml2-driver.cpp", TINYXML2_DRIVER),
            ),
            (("/usr/bin/mkdir", "-p", ".jstack-grader/tinyxml2"),
             ("/usr/bin/gcc", "-x", "c++", "-std=c++11", "-DTINYXML2_DEBUG", "-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-I", ".", "tinyxml2.cpp", "/runner/tinyxml2-driver.cpp", "-lstdc++", "-o", ".jstack-grader/tinyxml2/driver")),
            ("/usr/bin/python3", "/runner/adapter.py"),
        )
    if adapter == "sqlite-utils-foreign-key":
        return runner("adapter.py", SQLITE_UTILS_FOREIGN_KEY, ("/usr/bin/python3", "/runner/adapter.py"))
    if adapter == "linenoise-history-resize":
        return (
            (
                ("runner", "adapter.py", LINENOISE_HISTORY_RESIZE),
                ("runner", "linenoise-driver.c", LINENOISE_DRIVER),
            ),
            (("/usr/bin/mkdir", "-p", ".jstack-grader/linenoise"),
             ("/usr/bin/gcc", "-std=c99", "-D_POSIX_C_SOURCE=200809L", "-include", "strings.h", "-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-I", ".", "linenoise.c", "/runner/linenoise-driver.c", "-o", ".jstack-grader/linenoise/driver")),
            ("/usr/bin/python3", "/runner/adapter.py"),
        )
    raise GradeError("task registry references an unimplemented fixed adapter")


def _validate_adapter_inputs(adapter: str, inputs: Sequence[Any]) -> None:
    def exact(item: Any, fields: Sequence[str], field: str) -> Dict[str, Any]:
        if not isinstance(item, dict) or set(item) != set(fields):
            raise GradeError("%s has an invalid fixed-adapter input shape" % field)
        return item

    for index, raw in enumerate(inputs):
        field = "%s input %d" % (adapter, index)
        if adapter == "hono-json-media":
            item = exact(raw, ("body", "contentType"), field)
            if not isinstance(item["body"], dict) or len(item["body"]) > 128:
                raise GradeError("%s body must be a bounded JSON object" % field)
            if not (
                item["contentType"] is None
                or isinstance(item["contentType"], str)
                and 0 < len(item["contentType"].encode("utf-8")) <= 512
            ):
                raise GradeError("%s contentType is invalid" % field)
        elif adapter == "starlette-url-replace":
            item = exact(raw, ("field", "url", "value"), field)
            if item["field"] not in ("hostname", "password", "port", "username"):
                raise GradeError("%s URL field is outside the fixed enum" % field)
            if not isinstance(item["url"], str) or len(item["url"].encode("utf-8")) > 4096:
                raise GradeError("%s URL is invalid" % field)
            if item["field"] == "port":
                value = item["value"]
                if value is not None and (
                    isinstance(value, bool) or not isinstance(value, int) or not 0 <= value <= 65535
                ):
                    raise GradeError("%s URL port is invalid" % field)
            elif not (
                item["value"] is None
                or isinstance(item["value"], str)
                and len(item["value"].encode("utf-8")) <= 2048
            ):
                raise GradeError("%s URL replacement string is invalid" % field)
        elif adapter == "nanohttpd-response":
            item = exact(raw, ("bodyUtf8", "explicitContentLength", "gzip", "transfer"), field)
            if not isinstance(item["bodyUtf8"], str) or len(item["bodyUtf8"].encode("utf-8")) > 16384:
                raise GradeError("%s response body is invalid" % field)
            length = item["explicitContentLength"]
            if length is not None and (
                isinstance(length, bool) or not isinstance(length, int) or not 0 <= length <= 32768
            ):
                raise GradeError("%s explicit content length is invalid" % field)
            if not isinstance(item["gzip"], bool) or item["transfer"] not in ("chunked", "fixed", "head"):
                raise GradeError("%s response transfer fields are invalid" % field)
        elif adapter == "tinyxml2-character-reference":
            item = exact(raw, ("observe", "xml"), field)
            if (
                not isinstance(item["xml"], str)
                or not 0 < len(item["xml"].encode("utf-8")) <= 32768
                or item["observe"] not in ("completed", "error-code", "text")
            ):
                raise GradeError("%s XML vector is invalid" % field)
        elif adapter == "sqlite-utils-foreign-key":
            item = exact(raw, ("columnName", "otherColumnName", "otherTableName"), field)
            for name in ("columnName", "otherColumnName", "otherTableName"):
                value = item[name]
                if not isinstance(value, str) or not value or len(value.encode("utf-8")) > 128:
                    raise GradeError("%s.%s is not a bounded identifier" % (field, name))
            if (
                item["columnName"].lower() == "id"
                or item["otherTableName"].lower() in ("items", "sqlite_master")
                or item["otherColumnName"].lower() == "value"
            ):
                raise GradeError("%s collides with a fixed harness identifier" % field)
        elif adapter == "linenoise-history-resize":
            item = exact(raw, ("entries", "initialMaximum", "newMaximum", "observe"), field)
            for name in ("initialMaximum", "newMaximum"):
                value = item[name]
                if isinstance(value, bool) or not isinstance(value, int) or not 1 <= value <= 1024:
                    raise GradeError("%s.%s is invalid" % (field, name))
            if item["observe"] not in ("completed", "entries"):
                raise GradeError("%s observation is outside the fixed enum" % field)
            entries = item["entries"]
            if not isinstance(entries, list) or not 1 <= len(entries) <= 64:
                raise GradeError("%s entries must be a bounded array" % field)
            if any(
                not isinstance(value, str)
                or not value
                or "\n" in value
                or "\r" in value
                or len(value.encode("utf-8")) > 32768
                for value in entries
            ):
                raise GradeError("%s entries contain an invalid value" % field)
        elif adapter == "typescript-redirect":
            item = exact(raw, ("applicationOrigin", "requested"), field)
            if (
                not isinstance(item["applicationOrigin"], str)
                or len(item["applicationOrigin"].encode("utf-8")) > 8192
                or not (
                    item["requested"] is None
                    or isinstance(item["requested"], str)
                    and len(item["requested"].encode("utf-8")) <= 8192
                )
            ):
                raise GradeError("%s has invalid strings" % field)
        elif adapter == "typescript-profile":
            item = exact(raw, ("displayName",), field)
            if not isinstance(item["displayName"], str) or len(item["displayName"].encode("utf-8")) > 4096:
                raise GradeError("%s displayName must be a string" % field)
        elif adapter == "python-transfer":
            item = exact(raw, ("operations",), field)
            if not isinstance(item["operations"], list) or not 1 <= len(item["operations"]) <= 32:
                raise GradeError("%s operations must be a bounded array" % field)
            for operation in item["operations"]:
                operation = exact(operation, ("userId", "idempotencyKey", "amount"), field)
                if not all(isinstance(operation[name], str) for name in ("userId", "idempotencyKey", "amount")):
                    raise GradeError("%s operation fields must be strings" % field)
        elif adapter == "python-webhook":
            item = exact(raw, ("bodyHex", "header", "secretHex", "now"), field)
            if not isinstance(item["header"], str) or isinstance(item["now"], bool) or not isinstance(item["now"], int):
                raise GradeError("%s has invalid webhook fields" % field)
            for name in ("bodyHex", "secretHex"):
                if not isinstance(item[name], str) or len(item[name]) % 2 or re.fullmatch(r"[0-9a-f]*", item[name]) is None:
                    raise GradeError("%s.%s must be lowercase hexadecimal" % (field, name))
        elif adapter in ("python-documents", "python-users"):
            if adapter == "python-documents":
                item = exact(raw, ("rows", "tenantId", "includeArchived"), field)
                widths = 4
                if not isinstance(item["tenantId"], str) or not isinstance(item["includeArchived"], bool):
                    raise GradeError("%s has invalid document query fields" % field)
            else:
                item = exact(raw, ("rows", "email"), field)
                widths = 3
                if not isinstance(item["email"], str):
                    raise GradeError("%s email must be a string" % field)
            if not isinstance(item["rows"], list) or len(item["rows"]) > 128 or any(not isinstance(row, list) or len(row) != widths for row in item["rows"]):
                raise GradeError("%s rows have an invalid shape" % field)
        elif adapter == "c-frame":
            item = exact(raw, ("frame", "outputCapacity"), field)
            if not isinstance(item["frame"], list) or len(item["frame"]) > 65537 or any(isinstance(value, bool) or not isinstance(value, int) or not 0 <= value <= 255 for value in item["frame"]):
                raise GradeError("%s frame must be bounded bytes" % field)
            if isinstance(item["outputCapacity"], bool) or not isinstance(item["outputCapacity"], int) or not 0 <= item["outputCapacity"] <= 256:
                raise GradeError("%s outputCapacity is invalid" % field)
        elif adapter == "c-decimal":
            item = exact(raw, ("text", "initialValue"), field)
            if not isinstance(item["text"], str) or isinstance(item["initialValue"], bool) or not isinstance(item["initialValue"], int) or not 0 <= item["initialValue"] <= 4_294_967_295:
                raise GradeError("%s decimal fields are invalid" % field)
        elif adapter == "legacy-config":
            item = exact(raw, ("contentsUtf8", "keyUtf8", "outputCapacity"), field)
            if not isinstance(item["contentsUtf8"], str) or not isinstance(item["keyUtf8"], str) or isinstance(item["outputCapacity"], bool) or not isinstance(item["outputCapacity"], int) or not 1 <= item["outputCapacity"] <= 65536:
                raise GradeError("%s legacy configuration fields are invalid" % field)
        elif adapter == "legacy-token":
            item = exact(raw, ("storedHex", "suppliedHex"), field)
            for name in ("storedHex", "suppliedHex"):
                if not isinstance(item[name], str) or len(item[name]) % 2 or len(item[name]) > 131072 or re.fullmatch(r"[0-9a-f]*", item[name]) is None:
                    raise GradeError("%s.%s must be bounded lowercase hexadecimal" % (field, name))
        elif adapter == "csharp-tenant-document":
            item = exact(raw, ("documents", "tenantId", "documentId"), field)
            if not isinstance(item["documents"], list) or len(item["documents"]) > 128 or not isinstance(item["tenantId"], str) or not isinstance(item["documentId"], str):
                raise GradeError("%s tenant-document fields are invalid" % field)
            for document in item["documents"]:
                document = exact(document, ("id", "tenantId", "contents"), field)
                if not all(isinstance(document[name], str) for name in ("id", "tenantId", "contents")):
                    raise GradeError("%s document fields must be strings" % field)
        elif adapter == "csharp-profile":
            item = exact(raw, ("json", "authenticatedIsAdmin"), field)
            if not isinstance(item["json"], str) or not isinstance(item["authenticatedIsAdmin"], bool):
                raise GradeError("%s profile fields are invalid" % field)
        else:
            raise GradeError("fixed adapter registry is incomplete")


def _validate_adapter_cases(
    adapter: str, cases: Sequence[Mapping[str, Any]], *, task_kind: str
) -> None:
    """Close expected-output shapes and assertion semantics for one adapter."""

    if adapter not in ADAPTER_OUTPUT_CONTRACTS:
        raise GradeError("fixed adapter output contract is incomplete")

    def exact(value: Any, fields: Sequence[str], field: str) -> Dict[str, Any]:
        if not isinstance(value, dict) or set(value) != set(fields):
            raise GradeError("%s has an impossible expected output shape" % field)
        return value

    def integer(value: Any, minimum: int, maximum: int, field: str) -> int:
        if isinstance(value, bool) or not isinstance(value, int) or not minimum <= value <= maximum:
            raise GradeError("%s must be one bounded integer" % field)
        return value

    def string(value: Any, field: str, *, nullable: bool = False) -> Optional[str]:
        if nullable and value is None:
            return None
        if not isinstance(value, str) or len(value.encode("utf-8")) > 32768:
            raise GradeError("%s must be one bounded string" % field)
        return value

    def string_list(value: Any, field: str, *, nullable: bool = False) -> Any:
        if nullable and value is None:
            return None
        if not isinstance(value, list) or len(value) > 256:
            raise GradeError("%s must be one bounded string array" % field)
        for index, item in enumerate(value):
            string(item, "%s[%d]" % (field, index))
        return value

    def boolean_assertion(case: Mapping[str, Any], field: str) -> None:
        assertion = case["assertion"]
        if assertion == "equals":
            if not isinstance(case["expected"], bool):
                raise GradeError("%s equals expected must be boolean" % field)
        elif assertion in ("is-true", "is-false"):
            if case["expected"] is not None:
                raise GradeError("%s unary boolean assertion expected must be null" % field)
        else:
            raise GradeError("%s assertion is not valid for a boolean output" % field)

    def nullable_assertion(
        case: Mapping[str, Any], field: str, validate_nonnull: Any
    ) -> None:
        assertion = case["assertion"]
        if assertion == "is-null":
            if case["expected"] is not None:
                raise GradeError("%s is-null expected must be null" % field)
        elif assertion == "equals":
            if case["expected"] is not None:
                validate_nonnull(case["expected"], field + ".expected")
        else:
            raise GradeError("%s assertion is invalid for a nullable output" % field)

    def expected_shape(case: Mapping[str, Any], index: int) -> None:
        field = "%s case %d" % (adapter, index)
        assertion = case["assertion"]
        expected = case["expected"]
        input_value = case["input"]
        if assertion not in ADAPTER_OUTPUT_CONTRACTS[adapter][1]:
            raise GradeError("%s assertion is outside the fixed output contract" % field)

        if adapter in ("typescript-redirect", "typescript-profile"):
            if assertion != "equals":
                raise GradeError("%s requires exact equality" % field)
            string(expected, field + ".expected")
        elif adapter in ("python-webhook", "legacy-token"):
            boolean_assertion(case, field)
        elif adapter == "hono-json-media":
            if assertion != "equals":
                raise GradeError("%s requires exact equality" % field)
            value = exact(expected, ("status", "value"), field + ".expected")
            integer(value["status"], 100, 599, field + ".expected.status")
            _safe_data(value["value"], field + ".expected.value")
        elif adapter == "python-transfer":
            if assertion != "equals" or not isinstance(expected, list):
                raise GradeError("%s requires one exact transfer array" % field)
            if len(expected) != len(input_value["operations"]):
                raise GradeError("%s transfer count cannot match the fixed adapter" % field)
            for row_index, raw in enumerate(expected):
                row = exact(raw, ("transferId", "userId", "amount"), field + ".expected")
                for name in ("transferId", "userId", "amount"):
                    string(row[name], "%s.expected[%d].%s" % (field, row_index, name))
        elif adapter == "starlette-url-replace":
            if assertion != "equals":
                raise GradeError("%s requires exact equality" % field)
            names = (
                "completed", "fragment", "hostname", "netloc", "password", "path",
                "port", "query", "scheme", "url", "username",
            )
            row = exact(expected, names, field + ".expected")
            if not isinstance(row["completed"], bool):
                raise GradeError("%s completed must be boolean" % field)
            if row["completed"] is False:
                if any(row[name] is not None for name in names if name != "completed"):
                    raise GradeError("%s failure record must use the fixed null sentinel" % field)
            else:
                for name in ("fragment", "netloc", "path", "query", "scheme", "url"):
                    string(row[name], "%s.expected.%s" % (field, name))
                for name in ("hostname", "password", "username"):
                    string(row[name], "%s.expected.%s" % (field, name), nullable=True)
                if row["port"] is not None:
                    integer(row["port"], 0, 65535, field + ".expected.port")
        elif adapter == "nanohttpd-response":
            if assertion != "equals":
                raise GradeError("%s requires exact equality" % field)
            row = exact(
                expected,
                ("bodyHex", "completed", "contentLengthValues", "statusLine", "transferEncodingValues"),
                field + ".expected",
            )
            if not isinstance(row["completed"], bool):
                raise GradeError("%s completed must be boolean" % field)
            if row["completed"] is False:
                if row != {
                    "bodyHex": None,
                    "completed": False,
                    "contentLengthValues": [],
                    "statusLine": None,
                    "transferEncodingValues": [],
                }:
                    raise GradeError("%s failure record must use the fixed sentinel" % field)
            else:
                string(row["bodyHex"], field + ".expected.bodyHex")
                if re.fullmatch(r"[0-9a-f]*", row["bodyHex"]) is None or len(row["bodyHex"]) % 2:
                    raise GradeError("%s bodyHex is invalid" % field)
                string_list(row["contentLengthValues"], field + ".expected.contentLengthValues")
                string(row["statusLine"], field + ".expected.statusLine")
                string_list(row["transferEncodingValues"], field + ".expected.transferEncodingValues")
        elif adapter == "csharp-tenant-document":
            def tenant(value: Any, selected_field: str) -> None:
                row = exact(value, ("contents", "id", "tenantId"), selected_field)
                for name in ("contents", "id", "tenantId"):
                    string(row[name], selected_field + "." + name)
            nullable_assertion(case, field, tenant)
        elif adapter == "csharp-profile":
            if assertion != "equals" or not isinstance(expected, dict):
                raise GradeError("%s requires one exact profile union" % field)
            if set(expected) == {"displayName", "isAdmin"}:
                string(expected["displayName"], field + ".expected.displayName")
                if not isinstance(expected["isAdmin"], bool):
                    raise GradeError("%s expected isAdmin must be boolean" % field)
            elif set(expected) == {"error"}:
                string(expected["error"], field + ".expected.error")
            else:
                raise GradeError("%s profile expected union is invalid" % field)
        elif adapter == "c-frame":
            if assertion != "equals":
                raise GradeError("%s requires exact equality" % field)
            row = exact(expected, ("accepted", "outputBytes", "guardIntact"), field + ".expected")
            if not isinstance(row["accepted"], bool) or not isinstance(row["guardIntact"], bool):
                raise GradeError("%s frame booleans are invalid" % field)
            if not isinstance(row["outputBytes"], list) or len(row["outputBytes"]) != input_value["outputCapacity"]:
                raise GradeError("%s output byte count cannot match the fixed adapter" % field)
            for byte in row["outputBytes"]:
                integer(byte, 0, 255, field + ".expected.outputBytes")
        elif adapter == "c-decimal":
            if assertion != "equals":
                raise GradeError("%s requires exact equality" % field)
            row = exact(expected, ("accepted", "value"), field + ".expected")
            if not isinstance(row["accepted"], bool):
                raise GradeError("%s accepted must be boolean" % field)
            integer(row["value"], 0, 4_294_967_295, field + ".expected.value")
        elif adapter == "tinyxml2-character-reference":
            observe = input_value["observe"]
            if observe == "completed":
                boolean_assertion(case, field)
            elif observe == "error-code":
                nullable_assertion(
                    case,
                    field,
                    lambda value, selected_field: integer(value, 0, 4_294_967_295, selected_field),
                )
            else:
                nullable_assertion(case, field, lambda value, selected_field: string(value, selected_field))
        elif adapter in ("python-documents", "python-users"):
            if assertion != "equals" or not isinstance(expected, list) or len(expected) > 128:
                raise GradeError("%s requires one bounded exact result array" % field)
            names = (
                ("documentId", "tenantId", "title", "archived")
                if adapter == "python-documents"
                else ("userId", "email", "displayName")
            )
            for row_index, raw in enumerate(expected):
                row = exact(raw, names, field + ".expected")
                id_name = names[0]
                integer(row[id_name], -9_007_199_254_740_991, 9_007_199_254_740_991, field + ".expected." + id_name)
                for name in names[1:]:
                    if name == "archived":
                        if not isinstance(row[name], bool):
                            raise GradeError("%s archived must be boolean" % field)
                    else:
                        string(row[name], "%s.expected[%d].%s" % (field, row_index, name))
        elif adapter == "sqlite-utils-foreign-key":
            if assertion != "equals":
                raise GradeError("%s requires exact equality" % field)
            row = exact(expected, ("completed", "foreignKeys", "integrity", "rows"), field + ".expected")
            if not isinstance(row["completed"], bool):
                raise GradeError("%s completed must be boolean" % field)
            if row["completed"] is False:
                if row != {"completed": False, "foreignKeys": [], "integrity": None, "rows": []}:
                    raise GradeError("%s failure record must use the fixed sentinel" % field)
            else:
                string(row["integrity"], field + ".expected.integrity")
                if not isinstance(row["foreignKeys"], list) or len(row["foreignKeys"]) > 128:
                    raise GradeError("%s foreignKeys must be bounded" % field)
                for foreign in row["foreignKeys"]:
                    item = exact(foreign, ("column", "otherColumn", "otherTable"), field + ".expected.foreignKeys")
                    for name in item:
                        string(item[name], field + ".expected.foreignKeys." + name)
                if not isinstance(row["rows"], list) or len(row["rows"]) > 128:
                    raise GradeError("%s rows must be bounded" % field)
                for values in row["rows"]:
                    if not isinstance(values, list) or len(values) != 2 or any(
                        isinstance(value, bool) or not isinstance(value, int) for value in values
                    ):
                        raise GradeError("%s rows contain a non-integer value" % field)
        elif adapter == "linenoise-history-resize":
            if input_value["observe"] == "completed":
                boolean_assertion(case, field)
            else:
                nullable_assertion(case, field, lambda value, selected_field: string_list(value, selected_field))
        elif adapter == "legacy-config":
            if assertion != "equals":
                raise GradeError("%s requires exact equality" % field)
            row = exact(expected, ("found", "valueUtf8", "guardIntact"), field + ".expected")
            integer(row["found"], 0, 1, field + ".expected.found")
            string(row["valueUtf8"], field + ".expected.valueUtf8")
            if not isinstance(row["guardIntact"], bool):
                raise GradeError("%s guardIntact must be boolean" % field)
        else:
            raise GradeError("fixed adapter output contract is incomplete")

    for index, case in enumerate(cases):
        if not isinstance(case, dict):
            raise GradeError("fixed adapter case must be one object")
        vulnerability_absent = case["vulnerabilityId"] is None
        if vulnerability_absent is not (case["previouslyPassing"] is True):
            raise GradeError(
                "holdout cases must classify every baseline outcome as passing or vulnerability-linked"
            )
        if task_kind == "clean-control" and case["category"] == "target" and not case["previouslyPassing"]:
            raise GradeError("clean-control target cases must be baseline-proven")
        expected_shape(case, index)


def _run_adapter(source_root: Path, adapter: str, inputs: Sequence[Any]) -> Optional[List[Any]]:
    _validate_adapter_inputs(adapter, inputs)
    assets, preparation, command = _adapter_assets(adapter)
    payload = _canonical_bytes(list(inputs)) + b"\n"
    with tempfile.TemporaryDirectory(prefix="jstack-fixed-adapter-", dir="/tmp") as raw_runner:
        runner_root = Path(raw_runner)
        written = set()
        for location, filename, source in assets:
            if location not in ("runner", "source"):
                raise GradeError("fixed adapter asset has an invalid location")
            relative = _safe_relative_path(filename)
            target_root = runner_root if location == "runner" else source_root
            target = target_root.joinpath(*PurePosixPath(relative).parts)
            identity = (location, relative)
            if identity in written:
                raise GradeError("fixed adapter declares a duplicate asset")
            written.add(identity)
            _write_fixed_file(target, source)
        for fixed_command in preparation:
            result = _run_inner(source_root, runner_root, fixed_command)
            if result.returncode != 0:
                return None
        result = _run_inner(source_root, runner_root, command, stdin=payload)
        if result.returncode != 0 or result.stderr:
            return None
    def reject_duplicates(pairs: Sequence[Tuple[str, Any]]) -> Dict[str, Any]:
        value: Dict[str, Any] = {}
        for key, item in pairs:
            if key in value:
                raise GradeError("fixed adapter emitted a duplicate JSON key")
            value[key] = item
        return value

    def reject_constant(value: str) -> None:
        raise GradeError("fixed adapter emitted non-finite JSON")

    try:
        value = json.loads(
            result.stdout.decode("utf-8", errors="strict"),
            object_pairs_hook=reject_duplicates,
            parse_constant=reject_constant,
        )
    except (UnicodeError, json.JSONDecodeError, GradeError, RecursionError):
        return None
    if not isinstance(value, list) or len(value) != len(inputs):
        return None
    try:
        return [_safe_data(item, "adapter output") for item in value]
    except GradeError:
        return None


def _assertion_passes(assertion: str, actual: Any, expected: Any) -> bool:
    if assertion == "equals":
        return actual == expected and type(actual) is type(expected)
    if assertion == "not-equals":
        return actual != expected or type(actual) is not type(expected)
    if assertion == "is-true":
        return actual is True
    if assertion == "is-false":
        return actual is False
    if assertion == "is-null":
        return actual is None
    if assertion == "is-non-null":
        return actual is not None
    raise GradeError("fixed assertion registry is incomplete")


def _case_outcomes(cases: Sequence[Mapping[str, Any]], actual: Optional[Sequence[Any]]) -> List[str]:
    if actual is None or len(actual) != len(cases):
        return ["error" for _ in cases]
    return [
        "pass" if _assertion_passes(case["assertion"], observed, case["expected"]) else "fail"
        for case, observed in zip(cases, actual)
    ]


def _derive_observation(
    bundle: Mapping[str, Any],
    *,
    candidate_commit: str,
    patch_sha256: str,
    public_test_failures: int,
    changed_path_violations: int,
    sanitizer_process_failures: int,
    baseline_outcomes: Sequence[str],
    candidate_outcomes: Sequence[str],
) -> Dict[str, Any]:
    cases = bundle["cases"]
    if len(baseline_outcomes) != len(cases) or len(candidate_outcomes) != len(cases):
        raise GradeError("fixed adapter did not produce exactly one outcome per holdout case")
    for case, outcome in zip(cases, baseline_outcomes):
        if case["previouslyPassing"] and outcome != "pass":
            raise GradeError("a sealed previously-passing case does not pass on the baseline")
        if case["vulnerabilityId"] is not None and outcome != "fail":
            raise GradeError("a sealed vulnerability does not reproduce on the baseline")

    patch_present = patch_sha256 != EMPTY_PATCH_SHA256
    previously_passing = sum(1 for case in cases if case["previouslyPassing"])
    regressed = sum(
        1 for case, outcome in zip(cases, candidate_outcomes)
        if case["previouslyPassing"] and outcome != "pass"
    )
    hidden_failures = sum(1 for outcome in candidate_outcomes if outcome != "pass")
    invariant_failures = sum(
        1 for case, outcome in zip(cases, candidate_outcomes)
        if case["category"] == "invariant" and outcome != "pass"
    )
    boundary_failures = changed_path_violations + sum(
        1 for case, outcome in zip(cases, candidate_outcomes)
        if case["category"] == "boundary" and outcome != "pass"
    )
    sanitizer_failures = sanitizer_process_failures + sum(
        1 for case, outcome in zip(cases, candidate_outcomes)
        if case["category"] == "sanitizer" and outcome != "pass"
    )
    vulnerabilities = sorted({
        case["vulnerabilityId"] for case in cases if case["vulnerabilityId"] is not None
    })
    correct = 0
    for vulnerability in vulnerabilities:
        associated = [
            outcome for case, outcome in zip(cases, candidate_outcomes)
            if case["vulnerabilityId"] == vulnerability
        ]
        if patch_present and associated and all(outcome == "pass" for outcome in associated):
            correct += 1
    target_cases_pass = all(
        outcome == "pass" for case, outcome in zip(cases, candidate_outcomes)
        if case["category"] == "target"
    )
    if bundle["expectedOutcome"] == "fixed":
        target_satisfied = bool(patch_present and target_cases_pass and correct == len(vulnerabilities))
    else:
        target_satisfied = bool(not patch_present and target_cases_pass)

    body = {
        "schemaVersion": OBSERVATION_SCHEMA,
        "graderVersion": VERSION,
        "graderBinarySha256": bundle["graderBinarySha256"],
        "taskId": bundle["taskId"],
        "patchSha256": patch_sha256,
        "candidateCommit": candidate_commit,
        "baseline": {
            "previouslyPassingAssertions": previously_passing,
            "coverage": {"line": None, "branch": None, "mutation": None},
        },
        "candidate": {
            "regressedAssertions": regressed,
            "coverage": {"line": None, "branch": None, "mutation": None},
        },
        "security": {
            "knownVulnerabilities": len(vulnerabilities),
            "detectedTruePositives": correct,
            "attemptedVulnerabilityFixes": len(vulnerabilities) if patch_present else 0,
            "correctPatches": correct,
            "verifiedRisksIntercepted": correct,
        },
        "verification": {
            "publicTestFailures": public_test_failures,
            "hiddenTestFailures": hidden_failures,
            "invariantFailures": invariant_failures,
            "boundaryViolations": boundary_failures,
            "sanitizerFailures": sanitizer_failures,
            "targetOutcomeSatisfied": target_satisfied,
            "hiddenBehaviorRegression": regressed > 0,
        },
    }
    return {**body, "observationSha256": _canonical_digest(body)}


def baseline(
    bundle_path: Path = BUNDLE_PATH, grader_path: Path = GRADER_PATH
) -> Dict[str, Any]:
    """Reproduce one sealed task baseline without a model or candidate path."""

    bundle, bundle_raw_sha256 = _load_bundle(bundle_path)
    _grader_raw, grader_sha256 = _read_stable_file(
        grader_path, "fixed grader executable", 5_000_000
    )
    if grader_sha256 != bundle["graderBinarySha256"]:
        raise GradeError("sealed holdout bundle grader digest differs from this executable")
    task = TASKS[bundle["taskId"]]
    transport_commit = _baseline_repository_state(bundle["sourceContentSha256"])

    with tempfile.TemporaryDirectory(
        prefix="jstack-proof-baseline-", dir="/tmp"
    ) as raw_root:
        root = Path(raw_root)
        public_root = root / "public-baseline"
        _copy_workspace(public_root)
        public_failures = _run_command_sequence(public_root, task["publicCommands"])

        sanitizer_failures = 0
        if task["sanitizerCommands"]:
            sanitizer_root = root / "sanitizer-baseline"
            _copy_workspace(sanitizer_root)
            sanitizer_failures = _run_command_sequence(
                sanitizer_root, task["sanitizerCommands"]
            )

        adapter_root = root / "adapter-baseline"
        _copy_workspace(adapter_root)
        actual = _run_adapter(
            adapter_root,
            task["adapter"],
            [case["input"] for case in bundle["cases"]],
        )
        outcomes = _case_outcomes(bundle["cases"], actual)

    baseline_contract_satisfied = bool(
        actual is not None
        and public_failures == 0
        and sanitizer_failures == 0
        and all(
            not case["previouslyPassing"] or outcome == "pass"
            for case, outcome in zip(bundle["cases"], outcomes)
        )
        and all(
            case["vulnerabilityId"] is None or outcome == "fail"
            for case, outcome in zip(bundle["cases"], outcomes)
        )
    )
    if not baseline_contract_satisfied:
        raise GradeError("sealed holdout baseline contract did not reproduce")
    outcome_rows = [
        {
            "caseIdSha256": hashlib.sha256(case["caseId"].encode("utf-8")).hexdigest(),
            "outcome": outcome,
        }
        for case, outcome in zip(bundle["cases"], outcomes)
    ]
    vulnerabilities = sorted({
        case["vulnerabilityId"]
        for case in bundle["cases"]
        if case["vulnerabilityId"] is not None
    })
    reproduced_vulnerabilities = sum(
        all(
            outcome == "fail"
            for case, outcome in zip(bundle["cases"], outcomes)
            if case["vulnerabilityId"] == vulnerability
        )
        for vulnerability in vulnerabilities
    )
    case_binding = {
        "caseCount": len(bundle["cases"]),
        "caseSetSha256": _canonical_digest(bundle["cases"]),
        "caseOutcomeSetSha256": _canonical_digest(outcome_rows),
        "previouslyPassingCaseCount": sum(
            case["previouslyPassing"] for case in bundle["cases"]
        ),
        "knownVulnerabilityCount": len(vulnerabilities),
        "reproducedKnownVulnerabilityCount": reproduced_vulnerabilities,
        "baselineContractSatisfied": True,
    }
    process_summary = {
        "publicCommandCount": len(task["publicCommands"]),
        "publicFailedProcessCount": public_failures,
        "sanitizerCommandCount": len(task["sanitizerCommands"]),
        "sanitizerFailedProcessCount": sanitizer_failures,
        "adapterCompleted": True,
    }
    body = {
        "schemaVersion": BASELINE_OBSERVATION_SCHEMA,
        "taskId": bundle["taskId"],
        "baselineCommit": bundle["baselineCommit"],
        "transportBaselineCommit": transport_commit,
        "sourceArchiveSha256": bundle["sourceArchiveSha256"],
        "sourceContentSha256": bundle["sourceContentSha256"],
        "holdoutBundleRawSha256": bundle_raw_sha256,
        "holdoutBundleSelfSha256": bundle["bundleSha256"],
        "graderVersion": VERSION,
        "graderBinarySha256": grader_sha256,
        "adapterVersion": ADAPTER_VERSION,
        "adapterId": bundle["adapterId"],
        "adapterContractSha256": _adapter_contract_sha256(grader_sha256),
        "publicCommandSetSha256": _canonical_digest(
            [list(command) for command in task["publicCommands"]]
        ),
        "sanitizerCommandSetSha256": _canonical_digest(
            [list(command) for command in task["sanitizerCommands"]]
        ),
        "processSummary": process_summary,
        "caseBinding": case_binding,
        "provenance": "reproduced-on-frozen-source",
    }
    return {**body, "observationSha256": _canonical_digest(body)}


def grade(bundle_path: Path = BUNDLE_PATH, grader_path: Path = GRADER_PATH) -> Dict[str, Any]:
    bundle, _bundle_raw_sha256 = _load_bundle(bundle_path)
    _grader_raw, grader_sha256 = _read_stable_file(grader_path, "fixed grader executable", 5_000_000)
    if grader_sha256 != bundle["graderBinarySha256"]:
        raise GradeError("sealed holdout bundle grader digest differs from this executable")
    task = TASKS[bundle["taskId"]]
    candidate_commit, transport_baseline_commit, patch, changed = _repository_state()
    patch_sha256 = hashlib.sha256(patch).hexdigest()

    with tempfile.TemporaryDirectory(prefix="jstack-proof-grade-", dir="/tmp") as raw_root:
        root = Path(raw_root)
        public_root = root / "public-candidate"
        _copy_workspace(public_root)
        public_test_failures = _run_command_sequence(public_root, task["publicCommands"])

        sanitizer_process_failures = 0
        if task["sanitizerCommands"]:
            sanitizer_root = root / "sanitizer-candidate"
            _copy_workspace(sanitizer_root)
            sanitizer_process_failures = _run_command_sequence(
                sanitizer_root, task["sanitizerCommands"]
            )

        baseline_root = root / "baseline"
        candidate_root = root / "candidate"
        _materialize_baseline(baseline_root, transport_baseline_commit)
        _copy_workspace(candidate_root)
        inputs = [case["input"] for case in bundle["cases"]]
        baseline_actual = _run_adapter(baseline_root, task["adapter"], inputs)
        candidate_actual = _run_adapter(candidate_root, task["adapter"], inputs)
        baseline_outcomes = _case_outcomes(bundle["cases"], baseline_actual)
        candidate_outcomes = _case_outcomes(bundle["cases"], candidate_actual)

    return _derive_observation(
        bundle,
        candidate_commit=candidate_commit,
        patch_sha256=patch_sha256,
        public_test_failures=public_test_failures,
        changed_path_violations=_boundary_violations(task, changed),
        sanitizer_process_failures=sanitizer_process_failures,
        baseline_outcomes=baseline_outcomes,
        candidate_outcomes=candidate_outcomes,
    )


def main(argv: Sequence[str]) -> int:
    selected = list(argv)
    baseline_only = selected == ["--baseline-only", str(BUNDLE_PATH)]
    candidate_grade = selected == [str(BUNDLE_PATH)]
    if not baseline_only and not candidate_grade:
        sys.stderr.write("jstack-proof-grade: expected one closed grader mode\n")
        return 2
    try:
        observation = baseline() if baseline_only else grade()
        sys.stdout.buffer.write(_canonical_bytes(observation) + b"\n")
        sys.stdout.buffer.flush()
        return 0
    except GradeError as exc:
        sys.stderr.write("jstack-proof-grade: %s\n" % exc)
        return 2
    except Exception:
        # Candidate-controlled files can provoke operating-system and
        # toolchain exceptions.  Keep that failure closed and non-diagnostic;
        # private paths, case data, and tracebacks must never escape stderr.
        sys.stderr.write("jstack-proof-grade: closed internal verifier failure\n")
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
