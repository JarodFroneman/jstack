C_FRAME = r'''import ctypes, json, sys
library = ctypes.CDLL("/workspace/.jstack-grader/libtarget.so")
function = library.frame_decode_text
function.argtypes = [ctypes.POINTER(ctypes.c_uint8), ctypes.c_size_t, ctypes.POINTER(ctypes.c_char), ctypes.c_size_t]
function.restype = ctypes.c_bool
output = []
for item in json.load(sys.stdin):
    frame_values = item["frame"]
    frame = (ctypes.c_uint8 * max(1, len(frame_values)))(*frame_values)
    capacity = item["outputCapacity"]
    guard_size = 32
    storage = (ctypes.c_ubyte * (max(1, capacity) + guard_size))()
    for index in range(len(storage)):
        storage[index] = 165
    accepted = bool(function(frame, len(frame_values), ctypes.cast(storage, ctypes.POINTER(ctypes.c_char)), capacity))
    guard_start = capacity
    output.append({"accepted": accepted, "outputBytes": list(storage[:capacity]), "guardIntact": all(value == 165 for value in storage[guard_start:])})
sys.stdout.write(json.dumps(output, sort_keys=True, separators=(",", ":")) + "\n")
'''

