def _adapter_contract_document(grader_binary_sha256: str) -> Dict[str, Any]:
    """Return the public, digest-only registry contract used by host staging.

    The executable's SHA-256 binds the task-specific input-shape code below;
    the structured rows bind every fixed adapter and process sequence without
    copying any holdout case bytes into the image or into a status document.
    """

    rows = []
    for task_id in sorted(TASKS):
        task = TASKS[task_id]
        rows.append(
            {
                "taskId": task_id,
                "family": task["family"],
                "taskKind": task["kind"],
                "adapter": task["adapter"],
                "allowedPaths": list(task["allowed"]),
                "forbiddenPaths": list(task["forbidden"]),
                "maximumChangedFiles": task["maximumFiles"],
                "publicCommands": [list(command) for command in task["publicCommands"]],
                "sanitizerCommands": [list(command) for command in task["sanitizerCommands"]],
            }
        )
    return {
        "schemaVersion": "jstack.eval.fixed-adapter-contract.v1",
        "graderVersion": VERSION,
        "graderBinarySha256": _sha256(
            grader_binary_sha256, "adapter-contract graderBinarySha256", real=True
        ),
        "adapterCaseContractVersion": ADAPTER_CASE_CONTRACT_VERSION,
        "caseClassificationPolicy": (
            "vulnerability-id-null-iff-previously-passing"
        ),
        "adapterOutputContracts": [
            {
                "adapter": adapter,
                "expectedShape": ADAPTER_OUTPUT_CONTRACTS[adapter][0],
                "allowedAssertions": list(ADAPTER_OUTPUT_CONTRACTS[adapter][1]),
            }
            for adapter in sorted(ADAPTER_OUTPUT_CONTRACTS)
        ],
        "taskCount": 18,
        "tasks": rows,
    }


def _adapter_contract_sha256(grader_binary_sha256: str) -> str:
    return _canonical_digest(_adapter_contract_document(grader_binary_sha256))

class GradeError(Exception):
    """A closed grader failure.  No traceback is emitted in production."""


def _canonical_bytes(value: object) -> bytes:
    try:
        return json.dumps(
            value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
        ).encode("utf-8")
    except (TypeError, ValueError, RecursionError) as exc:
        raise GradeError("grader value could not be encoded canonically") from exc


def _canonical_digest(value: object) -> str:
    return hashlib.sha256(_canonical_bytes(value)).hexdigest()


def _exact_fields(value: Mapping[str, Any], expected: Sequence[str], field: str) -> None:
    if set(value) != set(expected):
        raise GradeError("%s has fields outside its closed schema" % field)


def _sha256(value: object, field: str, *, real: bool = False) -> str:
    if not isinstance(value, str) or SHA256_RE.fullmatch(value) is None:
        raise GradeError("%s must be one lowercase SHA-256 digest" % field)
    if real and len(set(value)) == 1:
        raise GradeError("%s must be a real content digest" % field)
    return value


def _git_sha1(value: object, field: str) -> str:
    if not isinstance(value, str) or GIT_SHA1_RE.fullmatch(value) is None or len(set(value)) == 1:
        raise GradeError("%s must be one real lowercase Git SHA-1" % field)
    return value


def _identifier(value: object, field: str) -> str:
    if not isinstance(value, str) or IDENTIFIER_RE.fullmatch(value) is None:
        raise GradeError("%s must be one closed identifier" % field)
    return value


def _read_stable_file(path: Path, field: str, maximum_bytes: int) -> Tuple[bytes, str]:
    try:
        before = path.lstat()
    except OSError as exc:
        raise GradeError("%s is absent" % field) from exc
    if stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode) or not 0 < before.st_size <= maximum_bytes:
        raise GradeError("%s must be one bounded regular non-symlink file" % field)
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    try:
        descriptor = os.open(str(path), flags)
    except OSError as exc:
        raise GradeError("%s could not be opened safely" % field) from exc
    try:
        opened = os.fstat(descriptor)
        if not stat.S_ISREG(opened.st_mode) or not os.path.samestat(before, opened):
            raise GradeError("%s changed while it was opened" % field)
        chunks: List[bytes] = []
        remaining = maximum_bytes + 1
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
        after = os.fstat(descriptor)
        if len(raw) > maximum_bytes or not os.path.samestat(opened, after) or opened.st_size != after.st_size:
            raise GradeError("%s changed or exceeded its byte limit while read" % field)
    finally:
        os.close(descriptor)
    try:
        current = path.lstat()
    except OSError as exc:
        raise GradeError("%s changed after it was read" % field) from exc
    if stat.S_ISLNK(current.st_mode) or not os.path.samestat(after, current):
        raise GradeError("%s changed after it was read" % field)
    return raw, hashlib.sha256(raw).hexdigest()


def _safe_data(value: Any, field: str, depth: int = 0, counter: Optional[List[int]] = None) -> Any:
    if counter is None:
        counter = [0]
    counter[0] += 1
    if depth > 8 or counter[0] > 4096:
        raise GradeError("%s exceeds the closed data complexity limit" % field)
    if value is None or isinstance(value, bool):
        return value
    if isinstance(value, int) and not isinstance(value, bool):
        if not -9_007_199_254_740_991 <= value <= 9_007_199_254_740_991:
            raise GradeError("%s integer is outside the exact JSON range" % field)
        return value
    if isinstance(value, float):
        raise GradeError("%s must not contain floating-point values" % field)
    if isinstance(value, str):
        if "\x00" in value or len(value.encode("utf-8")) > 32_768:
            raise GradeError("%s contains a NUL or oversized string" % field)
        return value
    if isinstance(value, dict):
        if len(value) > 256:
            raise GradeError("%s contains too many object members" % field)
        normalized: Dict[str, Any] = {}
        for key in sorted(value):
            if not isinstance(key, str) or DATA_KEY_RE.fullmatch(key) is None:
                raise GradeError("%s contains an invalid key" % field)
            if key.lower().replace("-", "_") in FORBIDDEN_DATA_KEYS:
                raise GradeError("%s contains a forbidden execution selector" % field)
            normalized[key] = _safe_data(value[key], "%s.%s" % (field, key), depth + 1, counter)
        return normalized
    if isinstance(value, list):
        if len(value) > 256:
            raise GradeError("%s contains too many array members" % field)
        return [_safe_data(item, "%s[%d]" % (field, index), depth + 1, counter) for index, item in enumerate(value)]
    raise GradeError("%s must contain only bounded deterministic JSON data" % field)


def _load_bundle(path: Path) -> Tuple[Dict[str, Any], str]:
    raw, raw_sha256 = _read_stable_file(path, "sealed holdout bundle", MAX_BUNDLE_BYTES)

    def reject_duplicates(pairs: Sequence[Tuple[str, Any]]) -> Dict[str, Any]:
        result: Dict[str, Any] = {}
        for key, item in pairs:
            if key in result:
                raise GradeError("sealed holdout bundle contains a duplicate JSON key")
            result[key] = item
        return result

    def reject_constant(value: str) -> None:
        raise GradeError("sealed holdout bundle contains non-finite JSON")

    try:
        loaded = json.loads(
            raw.decode("utf-8", errors="strict"),
            object_pairs_hook=reject_duplicates,
            parse_constant=reject_constant,
        )
    except (UnicodeError, json.JSONDecodeError, GradeError, RecursionError) as exc:
        raise GradeError("sealed holdout bundle is not canonical UTF-8 JSON") from exc
    if not isinstance(loaded, dict) or raw != _canonical_bytes(loaded) + b"\n":
        raise GradeError("sealed holdout bundle must be canonical JSON plus one newline")
    _exact_fields(
        loaded,
        (
            "schemaVersion", "taskId", "family", "taskKind", "baselineCommit",
            "sourceArchiveSha256", "sourceContentSha256", "graderVersion",
            "graderBinarySha256", "adapterVersion", "adapterId", "expectedOutcome",
            "cases", "bundleSha256",
        ),
        "sealed holdout bundle",
    )
    if loaded["schemaVersion"] != BUNDLE_SCHEMA or loaded["graderVersion"] != VERSION:
        raise GradeError("sealed holdout bundle schema or grader version is invalid")
    if loaded["adapterVersion"] != ADAPTER_VERSION:
        raise GradeError("sealed holdout bundle adapter version is invalid")
    task_id = _identifier(loaded["taskId"], "holdout taskId")
    task = TASKS.get(task_id)
    if task is None:
        raise GradeError("sealed holdout bundle references an unknown task")
    if loaded["family"] != task["family"] or loaded["taskKind"] != task["kind"]:
        raise GradeError("sealed holdout bundle family or task kind differs from the fixed registry")
    if loaded["adapterId"] != "jstack-proof-adapter.%s.v1" % task_id:
        raise GradeError("sealed holdout bundle adapter identity differs from the fixed registry")
    expected_outcome = "safely-refused" if task["kind"] == "clean-control" else "fixed"
    if loaded["expectedOutcome"] != expected_outcome:
        raise GradeError("sealed holdout bundle expected outcome is invalid")
    _git_sha1(loaded["baselineCommit"], "holdout baselineCommit")
    _sha256(loaded["sourceArchiveSha256"], "holdout sourceArchiveSha256", real=True)
    _sha256(loaded["sourceContentSha256"], "holdout sourceContentSha256", real=True)
    _sha256(loaded["graderBinarySha256"], "holdout graderBinarySha256", real=True)
    digest = _sha256(loaded["bundleSha256"], "holdout bundleSha256")
    body = {key: loaded[key] for key in loaded if key != "bundleSha256"}
    if digest != _canonical_digest(body):
        raise GradeError("sealed holdout bundle self-digest is invalid")
    cases = loaded["cases"]
    if not isinstance(cases, list) or not 2 <= len(cases) <= 512:
        raise GradeError("sealed holdout bundle must contain 2 to 512 cases")
    normalized_cases = []
    seen = set()
    for index, item in enumerate(cases):
        if not isinstance(item, dict):
            raise GradeError("holdout case %d must be an object" % index)
        _exact_fields(item, ("caseId", "category", "assertion", "input", "expected", "previouslyPassing", "vulnerabilityId"), "holdout case %d" % index)
        case_id = _identifier(item["caseId"], "holdout caseId")
        if case_id in seen:
            raise GradeError("sealed holdout bundle contains duplicate case IDs")
        seen.add(case_id)
        if item["category"] not in CASE_CATEGORIES or item["assertion"] not in ASSERTIONS:
            raise GradeError("holdout case category or assertion is invalid")
        if not isinstance(item["previouslyPassing"], bool):
            raise GradeError("holdout case previouslyPassing must be boolean")
        vulnerability = item["vulnerabilityId"]
        if vulnerability is not None:
            _identifier(vulnerability, "holdout vulnerabilityId")
            if item["category"] not in ("security", "target") or item["previouslyPassing"]:
                raise GradeError("holdout vulnerability case has invalid metadata")
        expected = _safe_data(item["expected"], "holdout expected")
        if item["assertion"] in ("is-false", "is-non-null", "is-null", "is-true") and expected is not None:
            raise GradeError("unary holdout assertions require expected=null")
        normalized_cases.append({
            "caseId": case_id,
            "category": item["category"],
            "assertion": item["assertion"],
            "input": _safe_data(item["input"], "holdout input"),
            "expected": expected,
            "previouslyPassing": item["previouslyPassing"],
            "vulnerabilityId": vulnerability,
        })
    if [item["caseId"] for item in normalized_cases] != sorted(seen):
        raise GradeError("sealed holdout cases must be sorted by caseId")
    if not any(item["category"] == "target" for item in normalized_cases) or not any(item["previouslyPassing"] for item in normalized_cases):
        raise GradeError("sealed holdout bundle lacks a target or previously passing case")
    vulnerabilities = {item["vulnerabilityId"] for item in normalized_cases if item["vulnerabilityId"] is not None}
    if expected_outcome == "fixed" and not vulnerabilities:
        raise GradeError("fix-task holdout lacks a known vulnerability")
    if expected_outcome == "safely-refused" and vulnerabilities:
        raise GradeError("clean-control holdout declares a vulnerability")
    for vulnerability in vulnerabilities:
        if not any(
            case["vulnerabilityId"] == vulnerability and case["category"] == "target"
            for case in normalized_cases
        ):
            raise GradeError("each holdout vulnerability requires a target case")
    _validate_adapter_inputs(task["adapter"], [item["input"] for item in normalized_cases])
    _validate_adapter_cases(
        task["adapter"], normalized_cases, task_kind=task["kind"]
    )
    normalized = dict(loaded)
    normalized["cases"] = normalized_cases
    return normalized, raw_sha256


def _bounded_run(
    argv: Sequence[str],
    *,
    cwd: Path,
    environment: Mapping[str, str],
    stdin: bytes = b"",
    timeout: int = COMMAND_TIMEOUT_SECONDS,
    maximum_output: int = MAX_OUTPUT_BYTES,
) -> subprocess.CompletedProcess:
    if not argv or any(not isinstance(item, str) or not item or "\x00" in item for item in argv):
        raise GradeError("grader attempted an invalid fixed subprocess argv")
    try:
        with tempfile.TemporaryFile(dir="/tmp") as stdout_file, tempfile.TemporaryFile(dir="/tmp") as stderr_file:
            try:
                process = subprocess.run(
                    list(argv), input=stdin, stdout=stdout_file, stderr=stderr_file,
                    cwd=str(cwd), env=dict(environment), timeout=timeout, check=False,
                )
            except (OSError, subprocess.TimeoutExpired) as exc:
                raise GradeError("fixed grader subprocess failed to execute within its bound") from exc
            stdout_file.seek(0)
            stderr_file.seek(0)
            stdout = stdout_file.read(maximum_output + 1)
            stderr = stderr_file.read(maximum_output + 1)
    except OSError as exc:
        raise GradeError("grader could not create bounded output capture files") from exc
    if len(stdout) + len(stderr) > maximum_output:
        raise GradeError("fixed grader subprocess exceeded its output limit")
    return subprocess.CompletedProcess(list(argv), process.returncode, stdout, stderr)


def _git_environment() -> Dict[str, str]:
    return {
        "HOME": "/tmp/home",
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "GIT_DIR": str(GIT_DIRECTORY_PATH),
        "GIT_WORK_TREE": str(WORKSPACE_PATH),
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_TERMINAL_PROMPT": "0",
    }


def _git(arguments: Sequence[str], *, allowed: Sequence[int] = (0,), maximum_output: int = MAX_OUTPUT_BYTES) -> bytes:
    result = _bounded_run(
        (str(GIT_PATH), *arguments), cwd=WORKSPACE_PATH, environment=_git_environment(), maximum_output=maximum_output
    )
    if result.returncode not in allowed or result.stderr:
        raise GradeError("fixed Git inspection failed clean execution")
    return result.stdout


def _safe_relative_path(value: str) -> str:
    if not isinstance(value, str) or not value or "\x00" in value or "\\" in value:
        raise GradeError("Git returned an unsafe path")
    path = PurePosixPath(value)
    if path.is_absolute() or any(part in ("", ".", "..") for part in path.parts):
        raise GradeError("Git returned an unsafe path")
    return path.as_posix()


def _source_tree_digest(root: Path) -> str:
    """Hash normalized source paths, bytes, and executable bits.

    This is intentionally identical to the host executor's
    ``jstack.source-tree.v1`` projection.  The external Git directory is never
    below ``/workspace`` and therefore cannot enter the source binding.
    """

    if not root.is_absolute() or root.is_symlink() or not root.is_dir():
        raise GradeError("frozen baseline source root is invalid")
    entries: List[Dict[str, Any]] = []
    file_count = 0
    total_bytes = 0
    for directory, directory_names, file_names in os.walk(
        str(root), topdown=True, followlinks=False
    ):
        directory_names.sort()
        file_names.sort()
        base = Path(directory)
        for name in list(directory_names):
            path = base / name
            shape = path.lstat()
            if stat.S_ISLNK(shape.st_mode) or not stat.S_ISDIR(shape.st_mode):
                raise GradeError("frozen baseline source contains a link or special directory")
            entries.append(
                {
                    "path": _safe_relative_path(path.relative_to(root).as_posix()),
                    "type": "directory",
                }
            )
        for name in file_names:
            path = base / name
            shape = path.lstat()
            if stat.S_ISLNK(shape.st_mode) or not stat.S_ISREG(shape.st_mode):
                raise GradeError("frozen baseline source contains a link or special file")
            file_count += 1
            total_bytes += shape.st_size
            if file_count > MAX_SOURCE_FILES or total_bytes > MAX_SOURCE_BYTES:
                raise GradeError("frozen baseline source exceeds the closed limits")
            flags = os.O_RDONLY
            if hasattr(os, "O_NOFOLLOW"):
                flags |= os.O_NOFOLLOW
            descriptor = os.open(str(path), flags)
            try:
                opened = os.fstat(descriptor)
                if not stat.S_ISREG(opened.st_mode) or not os.path.samestat(shape, opened):
                    raise GradeError("frozen baseline source changed during inspection")
                hasher = hashlib.sha256()
                consumed = 0
                while True:
                    chunk = os.read(descriptor, 1024 * 1024)
                    if not chunk:
                        break
                    consumed += len(chunk)
                    hasher.update(chunk)
                after = os.fstat(descriptor)
                if consumed != shape.st_size or not os.path.samestat(opened, after):
                    raise GradeError("frozen baseline source changed during inspection")
                raw_sha256 = hasher.hexdigest()
            finally:
                os.close(descriptor)
            entries.append(
                {
                    "path": _safe_relative_path(path.relative_to(root).as_posix()),
                    "type": "file",
                    "executable": bool(shape.st_mode & 0o111),
                    "size": shape.st_size,
                    "sha256": raw_sha256,
                }
            )
    entries.sort(key=lambda item: (item["path"], item["type"]))
    return _canonical_digest(
        {"schemaVersion": "jstack.source-tree.v1", "entries": entries}
    )


def _baseline_repository_state(expected_source_content_sha256: str) -> str:
    """Require one clean root transport commit over the exact frozen source.

    Baseline production has no candidate commit, patch, model handle, or
    caller-selected revision.  The reviewed upstream/source commit remains a
    separately sealed identity in the bundle; this function proves only the
    deterministic transport commit made from those exact archive bytes.
    """

    expected = _sha256(
        expected_source_content_sha256, "baseline sourceContentSha256", real=True
    )
    if _git(("status", "--porcelain=v1", "--untracked-files=all")):
        raise GradeError("frozen baseline workspace is not clean")
    commit = _git(("rev-parse", "HEAD")).decode("ascii", errors="strict").strip()
    _git_sha1(commit, "transport baseline commit")
    parents = (
        _git(("rev-list", "--parents", "-n", "1", commit))
        .decode("ascii", errors="strict")
        .strip()
        .split()
    )
    if parents != [commit]:
        raise GradeError("baseline-only execution requires one root transport commit")
    if _source_tree_digest(WORKSPACE_PATH) != expected:
        raise GradeError("baseline-only workspace differs from the frozen source")
    return commit


def _repository_state() -> Tuple[str, str, bytes, Tuple[str, ...]]:
    """Return the candidate, transport baseline, exact patch, and changed paths.

    ``holdout.bundle.baselineCommit`` is the reviewed source identity (the
    upstream commit for a replay).  The host independently materializes the
    source archive as a deterministic transport commit, then optionally adds
    one candidate commit.  Those object IDs intentionally differ, so the
    grader derives ancestry only from the sealed, read-only ``/proof-git``
    repository instead of pretending the upstream object is present there.
    """

    status = _git(("status", "--porcelain=v1", "--untracked-files=all"))
    if status:
        raise GradeError("candidate workspace differs from its sealed Git commit")
    candidate = _git(("rev-parse", "HEAD")).decode("ascii", errors="strict").strip()
    _git_sha1(candidate, "candidate commit")
    parents = _git(("rev-list", "--parents", "-n", "1", candidate)).decode("ascii", errors="strict").strip().split()
    if not parents or parents[0] != candidate:
        raise GradeError("candidate commit ancestry is invalid")
    if len(parents) == 1:
        baseline = candidate
        patch = b""
    elif len(parents) == 2:
        baseline = _git_sha1(parents[1], "transport baseline commit")
        baseline_parents = _git(("rev-list", "--parents", "-n", "1", baseline)).decode(
            "ascii", errors="strict"
        ).strip().split()
        if baseline_parents != [baseline]:
            raise GradeError("transport baseline must be the sole root commit")
        baseline_paths_raw = _git(("ls-tree", "-r", "-z", "--name-only", baseline), maximum_output=20_000_000)
        baseline_paths = tuple(
            _safe_relative_path(item.decode("utf-8", errors="strict"))
            for item in baseline_paths_raw.split(b"\x00") if item
        )
        tracked = _git((
            "diff", "--binary", "--full-index", "--no-color", "--no-ext-diff",
            "--no-textconv", "--no-renames", baseline, candidate, "--", *baseline_paths,
        ), maximum_output=20_000_000)
        added_raw = _git(("diff", "--name-only", "--diff-filter=A", "-z", baseline, candidate, "--"), maximum_output=5_000_000)
        additions = sorted(
            _safe_relative_path(item.decode("utf-8", errors="strict"))
            for item in added_raw.split(b"\x00") if item
        )
        pieces = [tracked]
        for relative in additions:
            added = _git((
                "diff", "--no-index", "--binary", "--full-index", "--no-color",
                "--no-ext-diff", "--no-textconv", "--src-prefix=a/", "--dst-prefix=b/",
                "--", "/dev/null", relative,
            ), allowed=(1,), maximum_output=20_000_000)
            pieces.append(added)
        patch = b"".join(pieces)
    else:
        raise GradeError("candidate commit must have at most one transport parent")
    changed_raw = _git(("diff", "--name-only", "-z", baseline, candidate, "--"), maximum_output=5_000_000)
    changed = tuple(sorted(_safe_relative_path(item.decode("utf-8", errors="strict")) for item in changed_raw.split(b"\x00") if item))
    return candidate, baseline, patch, changed


def _path_under(path: str, boundary: str) -> bool:
    return path == boundary or path.startswith(boundary.rstrip("/") + "/")


def _boundary_violations(task: Mapping[str, Any], changed: Sequence[str]) -> int:
    invalid = {
        path for path in changed
        if not any(_path_under(path, allowed) for allowed in task["allowed"])
        or any(_path_under(path, forbidden) for forbidden in task["forbidden"])
    }
    return len(invalid) + max(0, len(set(changed)) - task["maximumFiles"])


def _copy_workspace(destination: Path) -> None:
    destination.mkdir(mode=0o700)
    file_count = 0
    total_bytes = 0
    for directory, directory_names, file_names in os.walk(str(WORKSPACE_PATH), topdown=True, followlinks=False):
        base = Path(directory)
        relative_base = base.relative_to(WORKSPACE_PATH)
        directory_names.sort()
        file_names.sort()
        for name in list(directory_names):
            source = base / name
            metadata = source.lstat()
            if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
                raise GradeError("candidate source contains a symlink or special directory")
            target = destination / relative_base / name
            target.mkdir(mode=0o700)
        for name in file_names:
            source = base / name
            metadata = source.lstat()
            if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
                raise GradeError("candidate source contains a symlink or special file")
            file_count += 1
            total_bytes += metadata.st_size
            if file_count > MAX_SOURCE_FILES or total_bytes > MAX_SOURCE_BYTES:
                raise GradeError("candidate source exceeds the closed copy limits")
            target = destination / relative_base / name
            target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
            descriptor = os.open(str(target), flags, 0o700 if metadata.st_mode & 0o111 else 0o600)
            try:
                with source.open("rb") as source_file, os.fdopen(descriptor, "wb") as target_file:
                    descriptor = -1
                    shutil.copyfileobj(source_file, target_file, length=1024 * 1024)
            finally:
                if descriptor >= 0:
                    os.close(descriptor)


def _materialize_baseline(destination: Path, commit: str) -> None:
    destination.mkdir(mode=0o700)
    listing = _git(("ls-tree", "-r", "-z", "--full-tree", commit), maximum_output=20_000_000)
    file_count = 0
    total_bytes = 0
    for raw_entry in listing.split(b"\x00"):
        if not raw_entry:
            continue
        try:
            header, raw_path = raw_entry.split(b"\t", 1)
            mode, object_type, object_id = header.decode("ascii", errors="strict").split(" ")
            relative = _safe_relative_path(raw_path.decode("utf-8", errors="strict"))
        except (ValueError, UnicodeError) as exc:
            raise GradeError("baseline Git tree contains an invalid entry") from exc
        if object_type != "blob" or mode not in ("100644", "100755") or not GIT_SHA1_RE.fullmatch(object_id):
            raise GradeError("baseline Git tree contains a symlink, submodule, or special entry")
        payload = _git(("cat-file", "blob", object_id), maximum_output=100_000_000)
        file_count += 1
        total_bytes += len(payload)
        if file_count > MAX_SOURCE_FILES or total_bytes > MAX_SOURCE_BYTES:
            raise GradeError("baseline source exceeds the closed materialization limits")
        target = destination.joinpath(*PurePosixPath(relative).parts)
        target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        descriptor = os.open(str(target), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o700 if mode == "100755" else 0o600)
        try:
            offset = 0
            while offset < len(payload):
                written = os.write(descriptor, payload[offset:])
                if written <= 0:
                    raise GradeError("baseline materialization made no write progress")
                offset += written
        finally:
            os.close(descriptor)


def _write_fixed_file(path: Path, payload: str, *, executable: bool = False) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    encoded = payload.encode("utf-8")
    descriptor = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o700 if executable else 0o600)
    try:
        offset = 0
        while offset < len(encoded):
            written = os.write(descriptor, encoded[offset:])
            if written <= 0:
                raise GradeError("fixed adapter materialization made no write progress")
            offset += written
    finally:
        os.close(descriptor)


def _inner_environment() -> Dict[str, str]:
    return {
        "HOME": "/tmp/home",
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/local/bin:/usr/bin",
        "PYTHONDONTWRITEBYTECODE": "1",
        "DOTNET_CLI_HOME": "/tmp/dotnet-home",
        "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1",
        "DOTNET_NOLOGO": "1",
        "NUGET_PACKAGES": "/tmp/nuget",
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:abort_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1",
    }


def _inner_argv(source_root: Path, runner_root: Path, command: Sequence[str]) -> Tuple[str, ...]:
    if not source_root.is_absolute() or not runner_root.is_absolute():
        raise GradeError("inner verifier roots must be absolute")
    argv: List[str] = [
        str(BWRAP_PATH),
        "--unshare-net", "--unshare-ipc", "--unshare-pid", "--unshare-uts",
        "--die-with-parent", "--new-session",
        "--ro-bind", "/usr", "/usr",
    ]
    if Path("/etc").is_dir() and not Path("/etc").is_symlink():
        argv.extend(("--ro-bind", "/etc", "/etc"))
    if Path("/usr/local").exists():
        argv.extend(("--ro-bind", "/usr/local", "/usr/local"))
    # Merged-/usr images expose these as links.  Non-merged images get only
    # their library trees, never the outer root or /sealed.
    for path in ("/lib", "/lib64", "/bin", "/sbin"):
        candidate = Path(path)
        if candidate.exists() and not candidate.is_symlink():
            argv.extend(("--ro-bind", path, path))
        elif candidate.is_symlink():
            target = os.readlink(path)
            if target.startswith("/") or ".." in PurePosixPath(target).parts:
                raise GradeError("inner verifier encountered an unsafe merged-/usr link")
            argv.extend(("--symlink", target, path))
    argv.extend((
        "--dir", "/workspace", "--bind", str(source_root), "/workspace",
        "--dir", "/runner", "--ro-bind", str(runner_root), "/runner",
        "--tmpfs", "/tmp", "--dir", "/tmp/home", "--dir", "/tmp/dotnet-home",
        "--dir", "/tmp/nuget", "--proc", "/proc", "--dev", "/dev",
        "--clearenv",
    ))
    for name, value in sorted(_inner_environment().items()):
        argv.extend(("--setenv", name, value))
    argv.extend(("--chdir", "/workspace", "--", *command))
    if "/sealed/holdout.bundle" in argv or "/sealed" in argv or "--ro-bind" not in argv:
        raise GradeError("inner verifier accidentally exposed the sealed holdout")
    return tuple(argv)


def _run_inner(
    source_root: Path,
    runner_root: Path,
    command: Sequence[str],
    *,
    stdin: bytes = b"",
    timeout: int = CASE_TIMEOUT_SECONDS,
) -> subprocess.CompletedProcess:
    return _bounded_run(
        _inner_argv(source_root, runner_root, command),
        cwd=Path("/tmp"),
        environment={"HOME": "/tmp/home", "LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"},
        stdin=stdin,
        timeout=timeout,
    )


def _run_command_sequence(source_root: Path, commands: Sequence[Sequence[str]]) -> int:
    with tempfile.TemporaryDirectory(prefix="jstack-fixed-runner-", dir="/tmp") as raw_runner:
        runner_root = Path(raw_runner)
        for command in commands:
            result = _run_inner(source_root, runner_root, command, timeout=COMMAND_TIMEOUT_SECONDS)
            if result.returncode != 0:
                return 1
        return 0


