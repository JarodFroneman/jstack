CSHARP_TENANT_DOCUMENT = r'''using System;
using System.Collections.Generic;
using System.Text.Json;
using TenantDocuments;

var inputs = JsonSerializer.Deserialize<List<Input>>(Console.In.ReadToEnd(), Options.Value)
    ?? throw new InvalidOperationException("inputs required");
var output = new List<object?>();
foreach (var item in inputs)
{
    var documents = new List<Document>();
    foreach (var value in item.Documents)
    {
        documents.Add(new Document(value.Id, value.TenantId, value.Contents));
    }
    var found = new TenantDocumentService(documents).Find(item.TenantId, item.DocumentId);
    output.Add(found is null ? null : new { contents = found.Contents, id = found.Id, tenantId = found.TenantId });
}
Console.Write(JsonSerializer.Serialize(output, Options.Value));
Console.Write("\n");

sealed class Input { public List<DocumentInput> Documents { get; set; } = new(); public string TenantId { get; set; } = ""; public string DocumentId { get; set; } = ""; }
sealed class DocumentInput { public string Id { get; set; } = ""; public string TenantId { get; set; } = ""; public string Contents { get; set; } = ""; }
static class Options { public static readonly JsonSerializerOptions Value = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase, PropertyNameCaseInsensitive = false }; }
'''

