#!/usr/bin/python3
"""Emit the closed, canary-observed tool report for a Beta.1 task image.

This file is installed verbatim as ``/usr/local/bin/jstack-proof-tool-report``.
It is intentionally self-contained: the SHA-256 recorded for the executable
therefore covers its parser, artifact checks, probe registry, and encoder.
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Dict, List, Mapping, Sequence, Tuple


VERSION = "jstack-proof-tool-report-v1"
MAX_ARTIFACT_BYTES = 100_000_000
MAX_PROBE_OUTPUT_BYTES = 32_768
MAX_MCP_OUTPUT_BYTES = 10_000_000
PROBE_TIMEOUT_SECONDS = 15
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
TOOL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")
VERSION_RE = re.compile(r"^[0-9A-Za-z][0-9A-Za-z._+:-]{0,127}$")

CANARY_PATH = Path("/usr/local/bin/jstack-proof-canary")
LAUNCHER_PATH = Path("/usr/local/bin/jstack-proof-canary-launcher")
REPORTER_PATH = Path("/usr/local/bin/jstack-proof-tool-report")
GRADER_PATH = Path("/usr/local/bin/jstack-proof-grade")
JSTACK_SERVER_PATH = Path("/opt/jstack/jstack_mcp_server.py")
JSTACK_TOOLS_PATH = Path("/opt/jstack/jstack_mcp_tools.json")

BINDING_TOOL_NAMES = frozenset(
    (
        "jstack-proof-canary-version",
        "jstack-proof-canary-sha256",
        "jstack-proof-canary-launcher-sha256",
        "jstack-proof-tool-report-sha256",
        "jstack-proof-grader-version",
        "jstack-proof-grader-sha256",
        "jstack-proof-runtime-sha256",
        "jstack-mcp-server-sha256",
        "jstack-mcp-tools-sha256",
        "jstack-mcp-tool-count",
    )
)
PROBE_TOOL_NAMES = frozenset(
    (
        "bubblewrap",
        "bun",
        "cc",
        "cmake",
        "coreutils",
        "ctest",
        "dotnet",
        "gcc",
        "git",
        "java",
        "make",
        "maven",
        "node",
        "npm",
        "python",
        "sqlite",
        "uv",
    )
)
ALLOWED_TOOL_NAMES = frozenset(BINDING_TOOL_NAMES | PROBE_TOOL_NAMES)
INTERNAL_PREREQUISITES = frozenset(
    BINDING_TOOL_NAMES | {"bubblewrap", "coreutils", "git", "python"}
)

# Every executable path and argument is reviewed here.  A holdout, caller, or
# environment variable cannot select a binary or append an argument.
PROBES = {
    "bubblewrap": (("/usr/bin/bwrap", "--version"), "bubblewrap"),
    "bun": (("/usr/local/bin/bun", "--version"), "plain"),
    "cc": (("/usr/bin/cc", "--version"), "compiler"),
    "cmake": (("/usr/bin/cmake", "--version"), "cmake"),
    "coreutils": (("/usr/bin/env", "--version"), "coreutils"),
    "ctest": (("/usr/bin/ctest", "--version"), "ctest"),
    "dotnet": (("/usr/bin/dotnet", "--version"), "plain"),
    "gcc": (("/usr/bin/gcc", "--version"), "compiler"),
    "git": (("/usr/bin/git", "--version"), "git"),
    "java": (("/usr/bin/java", "-version"), "java"),
    "make": (("/usr/bin/make", "--version"), "make"),
    "maven": (("/usr/bin/mvn", "--version"), "maven"),
    "node": (("/usr/bin/node", "--version"), "node"),
    "npm": (("/usr/bin/npm", "--version"), "plain"),
    "python": (("/usr/bin/python3", "--version"), "python"),
    "sqlite": (("/usr/bin/sqlite3", "--version"), "plain"),
    "uv": (("/usr/local/bin/uv", "--version"), "uv"),
}

VALUE_OPTIONS = (
    "--expected-canary-sha256",
    "--expected-launcher-sha256",
    "--expected-tool-report-sha256",
    "--runtime-sha256",
    "--grader-sha256",
    "--jstack-mcp-server-sha256",
    "--jstack-mcp-tools-sha256",
    "--jstack-mcp-tool-count",
)


class ReportError(Exception):
    """Closed, user-displayable failure without a traceback."""


def _canonical_bytes(value: object) -> bytes:
    try:
        return json.dumps(
            value,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
            allow_nan=False,
        ).encode("utf-8")
    except (TypeError, ValueError, RecursionError) as exc:
        raise ReportError("tool report could not be encoded canonically") from exc


def _sha256(value: object, field: str) -> str:
    if not isinstance(value, str) or SHA256_RE.fullmatch(value) is None:
        raise ReportError("%s must be one lowercase SHA-256 digest" % field)
    return value


def _stable_file_payload(path: Path, field: str, *, executable: bool) -> Tuple[bytes, str]:
    try:
        before = path.lstat()
    except OSError as exc:
        raise ReportError("%s is absent" % field) from exc
    if (
        stat.S_ISLNK(before.st_mode)
        or not stat.S_ISREG(before.st_mode)
        or before.st_size < 1
        or before.st_size > MAX_ARTIFACT_BYTES
        or (before.st_mode & 0o022) != 0
        or (executable and not os.access(str(path), os.X_OK))
    ):
        raise ReportError("%s is not an immutable bounded regular artifact" % field)
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    try:
        descriptor = os.open(str(path), flags)
    except OSError as exc:
        raise ReportError("%s could not be opened safely" % field) from exc
    try:
        opened = os.fstat(descriptor)
        if not stat.S_ISREG(opened.st_mode) or not os.path.samestat(before, opened):
            raise ReportError("%s changed while it was opened" % field)
        digest = hashlib.sha256()
        chunks: List[bytes] = []
        total = 0
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            total += len(chunk)
            if total > MAX_ARTIFACT_BYTES:
                raise ReportError("%s exceeds the artifact byte limit" % field)
            digest.update(chunk)
            chunks.append(chunk)
        after = os.fstat(descriptor)
        shape = lambda item: (
            item.st_dev,
            item.st_ino,
            item.st_mode,
            item.st_size,
            getattr(item, "st_mtime_ns", int(item.st_mtime * 1_000_000_000)),
            getattr(item, "st_ctime_ns", int(item.st_ctime * 1_000_000_000)),
        )
        if shape(opened) != shape(after):
            raise ReportError("%s changed while it was hashed" % field)
    finally:
        os.close(descriptor)
    try:
        current = path.lstat()
    except OSError as exc:
        raise ReportError("%s changed after it was hashed" % field) from exc
    if stat.S_ISLNK(current.st_mode) or not os.path.samestat(after, current):
        raise ReportError("%s changed after it was hashed" % field)
    return b"".join(chunks), digest.hexdigest()


def _stable_file_digest(path: Path, field: str, *, executable: bool) -> str:
    return _stable_file_payload(path, field, executable=executable)[1]


def _parse_arguments(argv: Sequence[str]) -> Tuple[Dict[str, str], Tuple[str, ...]]:
    values: Dict[str, str] = {}
    required: List[str] = []
    index = 0
    while index < len(argv):
        option = argv[index]
        if option not in VALUE_OPTIONS and option != "--required-tool":
            raise ReportError("unknown tool-report argument %r" % option)
        if index + 1 >= len(argv):
            raise ReportError("tool-report option %s is missing its value" % option)
        value = argv[index + 1]
        if not isinstance(value, str) or not value or value.startswith("--") or "\x00" in value:
            raise ReportError("tool-report option %s has an invalid value" % option)
        if option == "--required-tool":
            required.append(value)
        else:
            if option in values:
                raise ReportError("tool-report option %s was supplied more than once" % option)
            values[option] = value
        index += 2
    if set(values) != set(VALUE_OPTIONS):
        raise ReportError("tool-report arguments omit a required immutable binding")
    if not required or len(required) > len(ALLOWED_TOOL_NAMES):
        raise ReportError("tool-report required-tool set is empty or oversized")
    if len(set(required)) != len(required):
        raise ReportError("tool-report required-tool set contains a duplicate")
    if any(TOOL_RE.fullmatch(name) is None or name not in ALLOWED_TOOL_NAMES for name in required):
        raise ReportError("tool-report required-tool set contains an unknown name")
    selected = frozenset(required)
    if not INTERNAL_PREREQUISITES.issubset(selected):
        missing = sorted(INTERNAL_PREREQUISITES - selected)
        raise ReportError("tool-report omits internal prerequisite(s): %s" % ", ".join(missing))
    return values, tuple(sorted(required))


def _bounded_probe(argv: Sequence[str]) -> bytes:
    environment = {
        "HOME": "/tmp/home",
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
    }
    try:
        with tempfile.TemporaryFile(dir="/tmp") as stdout_file, tempfile.TemporaryFile(
            dir="/tmp"
        ) as stderr_file:
            try:
                process = subprocess.run(
                    list(argv),
                    stdin=subprocess.DEVNULL,
                    stdout=stdout_file,
                    stderr=stderr_file,
                    cwd="/",
                    env=environment,
                    timeout=PROBE_TIMEOUT_SECONDS,
                    check=False,
                )
            except (OSError, subprocess.TimeoutExpired) as exc:
                raise ReportError("fixed tool version probe failed to execute") from exc
            stdout_file.seek(0)
            stderr_file.seek(0)
            stdout = stdout_file.read(MAX_PROBE_OUTPUT_BYTES + 1)
            stderr = stderr_file.read(MAX_PROBE_OUTPUT_BYTES + 1)
    except OSError as exc:
        raise ReportError("tool reporter could not create bounded capture files") from exc
    if process.returncode != 0:
        raise ReportError("fixed tool version probe exited non-zero")
    if len(stdout) + len(stderr) > MAX_PROBE_OUTPUT_BYTES:
        raise ReportError("fixed tool version probe exceeded its output limit")
    combined = stdout + (b"\n" if stdout and stderr else b"") + stderr
    if not combined:
        raise ReportError("fixed tool version probe emitted no version")
    return combined


def _version_token(raw: bytes, style: str) -> str:
    try:
        text = raw.decode("utf-8", errors="strict")
    except UnicodeError as exc:
        raise ReportError("fixed tool version probe emitted non-UTF-8 output") from exc
    if any(ord(character) == 0 or ord(character) == 127 for character in text):
        raise ReportError("fixed tool version probe emitted a control character")
    first = next((line.strip() for line in text.splitlines() if line.strip()), "")
    patterns = {
        "bubblewrap": r"^bubblewrap\s+([0-9][0-9A-Za-z._+:-]{0,127})$",
        "cmake": r"^cmake version\s+([0-9][0-9A-Za-z._+:-]{0,127})$",
        "coreutils": r"^env \(GNU coreutils\)\s+([0-9][0-9A-Za-z._+:-]{0,127})$",
        "ctest": r"^ctest version\s+([0-9][0-9A-Za-z._+:-]{0,127})$",
        "git": r"^git version\s+([0-9][0-9A-Za-z._+:-]{0,127})$",
        "java": r"^[A-Za-z0-9._+-]+ version \"([0-9][0-9A-Za-z._+:-]{0,127})\"",
        "make": r"^GNU Make\s+([0-9][0-9A-Za-z._+:-]{0,127})$",
        "maven": r"^Apache Maven\s+([0-9][0-9A-Za-z._+:-]{0,127})",
        "node": r"^v([0-9][0-9A-Za-z._+:-]{0,127})$",
        "python": r"^Python\s+([0-9][0-9A-Za-z._+:-]{0,127})$",
        "uv": r"^uv\s+([0-9][0-9A-Za-z._+:-]{0,127})$",
    }
    if style == "plain":
        candidate = first
    elif style == "compiler":
        match = re.search(r"(?<![0-9])([0-9]+\.[0-9]+(?:\.[0-9]+)?(?:[-+._][0-9A-Za-z.-]+)?)", first)
        candidate = match.group(1) if match is not None else ""
    else:
        match = re.match(patterns[style], first)
        candidate = match.group(1) if match is not None else ""
    if VERSION_RE.fullmatch(candidate) is None or candidate.lower() in {
        "latest",
        "unknown",
        "pending",
        "placeholder",
        "tbd",
    }:
        raise ReportError("fixed tool probe output did not contain an exact supported version")
    return candidate


def _parse_tools_document(path: Path, expected_digest: str, expected_count: str) -> List[Dict[str, object]]:
    raw, raw_digest = _stable_file_payload(
        path, "JStack MCP tools document", executable=False
    )
    if raw_digest != expected_digest:
        raise ReportError("JStack MCP tools document digest mismatch")
    if expected_count != "52":
        raise ReportError("JStack MCP tools document must bind exactly 52 descriptors")

    def reject_duplicates(pairs: Sequence[Tuple[str, object]]) -> Dict[str, object]:
        value: Dict[str, object] = {}
        for name, item in pairs:
            if name in value:
                raise ReportError("JStack MCP tools document contains a duplicate JSON key")
            value[name] = item
        return value

    def reject_constant(value: str) -> None:
        raise ReportError("JStack MCP tools document contains non-finite JSON")

    try:
        value = json.loads(
            raw.decode("utf-8", errors="strict"),
            object_pairs_hook=reject_duplicates,
            parse_constant=reject_constant,
        )
    except (UnicodeError, json.JSONDecodeError, ReportError, RecursionError) as exc:
        raise ReportError("JStack MCP tools document is not bounded UTF-8 JSON") from exc
    if not isinstance(value, list) or len(value) != 52 or raw != _canonical_bytes(value):
        raise ReportError("JStack MCP tools document is not the canonical 52-descriptor array")
    names: List[str] = []
    normalized: List[Dict[str, object]] = []
    for index, item in enumerate(value):
        if not isinstance(item, dict) or set(item) != {
            "name",
            "description",
            "inputSchema",
            "annotations",
        }:
            raise ReportError("JStack MCP descriptor %d has an invalid closed shape" % index)
        name = item["name"]
        description = item["description"]
        input_schema = item["inputSchema"]
        annotations = item["annotations"]
        if (
            not isinstance(name, str)
            or TOOL_RE.fullmatch(name) is None
            or not name.startswith("jstack_")
            or not isinstance(description, str)
            or not description
            or description != description.strip()
            or len(description.encode("utf-8")) > 32_768
            or not isinstance(input_schema, dict)
            or input_schema.get("type") != "object"
            or not isinstance(annotations, dict)
        ):
            raise ReportError("JStack MCP descriptor %d is not a complete tool descriptor" % index)
        names.append(name)
        normalized.append(dict(item))
    if len(set(names)) != 52 or names != sorted(names):
        raise ReportError("JStack MCP descriptors must have 52 unique sorted names")
    return normalized


def _probe_mcp_tools(server_path: Path) -> List[Dict[str, object]]:
    requests = (
        {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
                "protocolVersion": "2025-11-25",
                "capabilities": {},
                "clientInfo": {
                    "name": "jstack-proof-image-runtime",
                    "version": VERSION,
                },
            },
        },
        {"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}},
    )
    payload = b"".join(_canonical_bytes(item) + b"\n" for item in requests)
    environment = {
        "HOME": "/tmp/home",
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "PYTHONDONTWRITEBYTECODE": "1",
    }
    try:
        with tempfile.TemporaryFile(dir="/tmp") as stdout_file, tempfile.TemporaryFile(
            dir="/tmp"
        ) as stderr_file:
            try:
                process = subprocess.run(
                    ["/usr/bin/python3", str(server_path)],
                    input=payload,
                    stdout=stdout_file,
                    stderr=stderr_file,
                    cwd="/workspace",
                    env=environment,
                    timeout=PROBE_TIMEOUT_SECONDS,
                    check=False,
                )
            except (OSError, subprocess.TimeoutExpired) as exc:
                raise ReportError("frozen JStack MCP surface probe failed to execute") from exc
            stdout_file.seek(0)
            stderr_file.seek(0)
            stdout = stdout_file.read(MAX_MCP_OUTPUT_BYTES + 1)
            stderr = stderr_file.read(MAX_MCP_OUTPUT_BYTES + 1)
    except OSError as exc:
        raise ReportError("MCP surface probe could not create bounded capture files") from exc
    if process.returncode != 0 or stderr or len(stdout) > MAX_MCP_OUTPUT_BYTES:
        raise ReportError("frozen JStack MCP surface probe failed clean execution")
    try:
        responses = [
            json.loads(line)
            for line in stdout.decode("utf-8", errors="strict").splitlines()
            if line
        ]
    except (UnicodeError, json.JSONDecodeError, RecursionError) as exc:
        raise ReportError("frozen JStack MCP surface probe returned invalid JSONL") from exc
    by_id = {
        item.get("id"): item
        for item in responses
        if isinstance(item, dict) and "id" in item
    }
    if set(by_id) != {1, 2} or not all(
        isinstance(by_id[index].get("result"), dict) for index in (1, 2)
    ):
        raise ReportError("frozen JStack MCP surface probe returned incomplete responses")
    tools = by_id[2]["result"].get("tools")
    if not isinstance(tools, list):
        raise ReportError("frozen JStack MCP server did not advertise a tool array")
    return sorted((dict(item) for item in tools if isinstance(item, dict)), key=lambda item: item.get("name", ""))


def build_report(
    argv: Sequence[str],
    *,
    paths: Mapping[str, Path] = None,
) -> Dict[str, str]:
    values, required = _parse_arguments(argv)
    selected_paths = {
        "canary": CANARY_PATH,
        "launcher": LAUNCHER_PATH,
        "reporter": REPORTER_PATH,
        "grader": GRADER_PATH,
        "server": JSTACK_SERVER_PATH,
        "tools": JSTACK_TOOLS_PATH,
    }
    if paths is not None:
        if set(paths) != set(selected_paths) or any(not isinstance(item, Path) for item in paths.values()):
            raise ReportError("test path seam must supply the exact runtime artifact set")
        selected_paths = dict(paths)
    count = values["--jstack-mcp-tool-count"]
    if count != "52":
        raise ReportError("JStack MCP tool count must be exactly 52")
    expected = {
        "canary": _sha256(values["--expected-canary-sha256"], "canary digest"),
        "launcher": _sha256(values["--expected-launcher-sha256"], "launcher digest"),
        "reporter": _sha256(values["--expected-tool-report-sha256"], "tool-report digest"),
        "grader": _sha256(values["--grader-sha256"], "grader digest"),
        "server": _sha256(values["--jstack-mcp-server-sha256"], "JStack MCP server digest"),
        "tools": _sha256(values["--jstack-mcp-tools-sha256"], "JStack MCP tools digest"),
    }
    runtime_digest = _sha256(values["--runtime-sha256"], "runtime digest")
    for name in ("canary", "launcher", "reporter", "grader"):
        if _stable_file_digest(selected_paths[name], name, executable=True) != expected[name]:
            raise ReportError("%s artifact digest mismatch" % name)
    if _stable_file_digest(selected_paths["server"], "JStack MCP server", executable=False) != expected["server"]:
        raise ReportError("JStack MCP server artifact digest mismatch")
    document_tools = _parse_tools_document(selected_paths["tools"], expected["tools"], count)
    advertised_tools = _probe_mcp_tools(selected_paths["server"])
    if advertised_tools != document_tools:
        raise ReportError("frozen JStack MCP server differs from its exact 52-descriptor document")

    bindings = {
        "jstack-proof-canary-version": "jstack-proof-canary-v1",
        "jstack-proof-canary-sha256": expected["canary"],
        "jstack-proof-canary-launcher-sha256": expected["launcher"],
        "jstack-proof-tool-report-sha256": expected["reporter"],
        "jstack-proof-grader-version": "jstack-proof-grader-v1",
        "jstack-proof-grader-sha256": expected["grader"],
        "jstack-proof-runtime-sha256": runtime_digest,
        "jstack-mcp-server-sha256": expected["server"],
        "jstack-mcp-tools-sha256": expected["tools"],
        "jstack-mcp-tool-count": count,
    }
    report: Dict[str, str] = {}
    for name in required:
        if name in bindings:
            report[name] = bindings[name]
        else:
            probe, style = PROBES[name]
            report[name] = _version_token(_bounded_probe(probe), style)
    if set(report) != set(required):
        raise ReportError("tool reporter did not produce the exact requested key set")
    return dict(sorted(report.items()))


def main(argv: Sequence[str]) -> int:
    try:
        report = build_report(argv)
        sys.stdout.buffer.write(_canonical_bytes(report) + b"\n")
        sys.stdout.buffer.flush()
        return 0
    except ReportError as exc:
        sys.stderr.write("jstack-proof-tool-report: %s\n" % exc)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
